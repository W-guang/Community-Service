/* ============================================================
   治理数据看板 — Premium Analytics Suite
   深靛蓝主题 · 层次卡片 · 数据可视化
   内置三张图表：环形图 · 横向柱状图 · 折线图
   ============================================================ */

.page {
  background: linear-gradient(180deg, #f0f2f8 0%, #f7f8fc 100%);
}

/* ============================================================
   1. Hero — 深靛蓝数据总览头部
   ============================================================ */
.dash-hero {
  position: relative;
  margin: 16rpx 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #0f0a2e 0%, #1e1b4b 25%, #312e81 55%, #3730a3 100%);
}
.dh-shine {
  position: absolute;
  top: -80rpx; right: -60rpx;
  width: 320rpx; height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(129,140,248,0.18) 0%, transparent 70%);
}
.dh-accent-ring {
  position: absolute;
  bottom: -100rpx; left: -80rpx;
  width: 280rpx; height: 280rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.06);
}
.dh-content {
  position: relative; z-index: 1;
  padding: 36rpx 32rpx 32rpx;
}
.dh-label {
  display: block;
  font-size: 20rpx; font-weight: 600; color: rgba(255,255,255,0.35);
  letter-spacing: 4rpx; text-transform: uppercase;
  margin-bottom: 4rpx;
}
.dh-title {
  display: block;
  font-size: 44rpx; font-weight: 800; color: #fff;
  letter-spacing: 2rpx; margin-bottom: 28rpx;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.15);
}
.dh-kpi-row {
  display: flex; justify-content: space-between;
  gap: 4rpx;
}
.dh-kpi { flex: 1; text-align: center; }
.dh-kpi-val {
  display: block; font-size: 42rpx; font-weight: 800;
  color: #fff; line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.dh-kpi-val.warn   { color: #fbbf24; }
.dh-kpi-val.danger { color: #f87171; }
.dh-kpi-label {
  display: block; font-size: 20rpx; color: rgba(255,255,255,0.55);
  margin-top: 6rpx; font-weight: 500;
}
.dh-pending-strip {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.1);
}
.dh-ps-left { display: flex; align-items: center; gap: 12rpx; }
.dh-ps-pulse {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #f87171;
  box-shadow: 0 0 10rpx rgba(248,113,113,0.5);
}
.dh-ps-text { font-size: 24rpx; color: rgba(255,255,255,0.85); }
.dh-ps-num { font-size: 28rpx; font-weight: 800; color: #fbbf24; }
.dh-ps-arrow { font-size: 32rpx; color: rgba(255,255,255,0.35); }
.dh-time {
  display: block; margin-top: 20rpx;
  font-size: 20rpx; color: rgba(255,255,255,0.4); text-align: right;
}

/* ============================================================
   2. 完成率双卡
   ============================================================ */
.comp-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
}
.comp-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.comp-top {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 8rpx;
}
.comp-badge {
  font-size: 22rpx; font-weight: 700; padding: 6rpx 16rpx;
  border-radius: 8rpx; color: #fff;
}
.comp-badge.repair-badge { background: #3b82f6; }
.comp-badge.help-badge   { background: #f59e0b; }
.comp-rate {
  font-size: 56rpx; font-weight: 800; color: #0f172a;
  line-height: 1; font-variant-numeric: tabular-nums;
}
.comp-rate-unit {
  font-size: 28rpx; font-weight: 600; color: #94a3b8; margin-left: 2rpx;
}
.comp-sub {
  display: block; font-size: 22rpx; color: #94a3b8; margin-bottom: 14rpx;
}
.comp-track {
  height: 8rpx; background: #f1f5f9; border-radius: 4rpx; overflow: hidden;
}
.comp-fill { height: 100%; border-radius: 4rpx; }
.comp-fill.repair-fill { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
.comp-fill.help-fill   { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

/* ============================================================
   3. 图表卡片通用样式
   ============================================================ */
.chart-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.chart-card-title {
  display: block;
  font-size: 30rpx; font-weight: 700; color: #1e293b;
  margin-bottom: 24rpx;
}

/* ---- 3a. 环形图 + Legend ---- */
.donut-row {
  display: flex; align-items: center; gap: 28rpx;
}
.donut-canvas-wrap {
  width: 260rpx; height: 260rpx; flex-shrink: 0;
}
.donut-canvas { width: 260rpx; height: 260rpx; }

.donut-legend {
  flex: 1; display: flex; flex-direction: column; gap: 16rpx;
}
.dl-item { display: flex; align-items: center; gap: 12rpx; }
.dl-dot {
  width: 14rpx; height: 14rpx; border-radius: 4rpx; flex-shrink: 0;
}
.dl-label {
  font-size: 26rpx; color: #475569; min-width: 80rpx; font-weight: 500;
}
.dl-value {
  font-size: 26rpx; font-weight: 700; color: #1e293b;
  min-width: 50rpx; text-align: right;
  font-variant-numeric: tabular-nums;
}
.dl-pct {
  font-size: 24rpx; color: #94a3b8;
  min-width: 72rpx; text-align: right;
}

/* ---- 3b. 横向柱状图 ---- */
.hbar-list { display: flex; flex-direction: column; gap: 18rpx; }
.hbar-row { display: flex; align-items: center; gap: 16rpx; }
.hbar-label {
  font-size: 26rpx; font-weight: 600; color: #475569;
  min-width: 108rpx; flex-shrink: 0;
}
.hbar-track {
  flex: 1; height: 36rpx; background: #f1f5f9;
  border-radius: 18rpx; overflow: hidden;
}
.hbar-fill {
  height: 100%; border-radius: 18rpx;
  background: linear-gradient(90deg, #1296db, #38bdf8);
}
.hbar-val {
  font-size: 24rpx; font-weight: 800; color: #1e293b;
  min-width: 48rpx; text-align: right; flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* ---- 3c. 折线图 ---- */
.line-canvas-wrap { width: 100%; height: 420rpx; }
.line-canvas { width: 100%; height: 420rpx; }

/* ============================================================
   4. SOS + 公告 双栏卡片
   ============================================================ */
.dual-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
}
.dual-card {
  background: #fff; border-radius: 24rpx; padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.dual-card.sos-card {
  border-left: 6rpx solid #ef4444;
  border-radius: 6rpx 24rpx 24rpx 6rpx;
}
.dual-icon-ring {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.dual-icon-ring.sos-ring    { background: #fef2f2; }
.dual-icon-ring.notice-ring  { background: #f5f3ff; }
.dual-icon-emoji { font-size: 36rpx; }
.dual-val {
  font-size: 56rpx; font-weight: 800; color: #0f172a;
  line-height: 1; font-variant-numeric: tabular-nums;
}
.dual-val.danger { color: #ef4444; }
.dual-lbl { font-size: 24rpx; color: #94a3b8; font-weight: 500; }
.dual-strip {
  margin-top: 4rpx; padding: 8rpx 20rpx; border-radius: 999rpx;
}
.dual-strip.sos-strip    { background: #fef2f2; }
.dual-strip.notice-strip { background: #f5f3ff; }
.dual-strip-text { font-size: 20rpx; font-weight: 600; }
.dual-strip.sos-strip .dual-strip-text    { color: #ef4444; }
.dual-strip.notice-strip .dual-strip-text { color: #7c3aed; }

/* ============================================================
   5. 报表导出卡片
   ============================================================ */
.export-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.ec-head { margin-bottom: 20rpx; }
.ec-head-left {
  display: flex; align-items: center; gap: 10rpx; margin-bottom: 6rpx;
}
.ec-icon { font-size: 32rpx; }
.ec-title { font-size: 28rpx; font-weight: 700; color: #0f172a; }
.ec-desc { font-size: 22rpx; color: #94a3b8; margin-left: 42rpx; display: block; }
.ec-btns { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ec-btn {
  display: flex; align-items: center; gap: 8rpx;
  padding: 16rpx 24rpx; border-radius: 16rpx;
  background: #f8fafc; border: 1rpx solid #e2e8f0;
}
.ec-btn:active { background: #eef2ff; border-color: #a5b4fc; }
.ec-btn.disabled { opacity: 0.5; pointer-events: none; }
.ec-btn-icon { font-size: 26rpx; }
.ec-btn-text { font-size: 24rpx; font-weight: 600; color: #334155; }
.ec-result {
  margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx;
  background: #f0f9ff; border: 1rpx solid #bae6fd;
}
.ec-result-text {
  font-size: 22rpx; color: #0369a1; white-space: pre-wrap;
  word-break: break-all; font-family: monospace;
}

/* ============================================================
   6. 加载 & 空状态
   ============================================================ */
.load-zone {
  display: flex; flex-direction: column; align-items: center;
  padding: 80rpx 0; gap: 20rpx;
}
.load-ring {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 4rpx solid #e2e8f0;
  border-top-color: #3b82f6;
  animation: lr-spin 0.8s linear infinite;
}
@keyframes lr-spin { to { transform: rotate(360deg); } }
.load-text { font-size: 26rpx; color: #94a3b8; }

.soft-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 80rpx 0; gap: 14rpx;
}
.se-icon-wrap {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #f1f5f9; display: flex; align-items: center;
  justify-content: center; margin-bottom: 6rpx;
}
.se-icon { font-size: 48rpx; }
.se-title { font-size: 28rpx; font-weight: 700; color: #334155; }
.se-desc  { font-size: 24rpx; color: #94a3b8; }
.btn-mini-fill {
  margin-top: 12rpx; border-radius: 14rpx; font-size: 26rpx;
  padding: 14rpx 32rpx; background: #3b82f6; color: #fff; border: none;
}
.btn-mini-fill:active { opacity: 0.85; }

/* ============================================================
   7. 布局工具
   ============================================================ */
.wrap {
  padding: 18rpx 24rpx 30rpx;
  display: flex; flex-direction: column; gap: 18rpx;
}
