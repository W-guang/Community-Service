/* ============================================================
   数据可视化分析页
   三张图表卡片：环形图 · 横向柱状图 · 折线图
   严格遵循项目设计规范：白色卡片+24rpx 圆角+柔和阴影
   Skyline 完全兼容（无 conic-gradient / 无 inset:0 / 无复杂动画）
   ============================================================ */

/* 页面底色 — 与仪表盘一致 */
.page {
  background: linear-gradient(180deg, #f0f2f8 0%, #f7f8fc 100%);
}

/* 布局容器 */
.wrap {
  padding: 18rpx 24rpx 30rpx;
  display: flex; flex-direction: column; gap: 22rpx;
}

/* ============================================================
   通用图表卡片样式
   ============================================================ */
.chart-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.chart-card-title {
  display: block;
  font-size: 30rpx; font-weight: 700; color: #1e293b;
  margin-bottom: 24rpx;
}

/* ============================================================
   Card 1 — 环形图 + Legend
   ============================================================ */
.donut-row {
  display: flex; align-items: center; gap: 28rpx;
}

/* Canvas 容器 */
.donut-canvas-wrap {
  width: 260rpx; height: 260rpx; flex-shrink: 0;
}
.donut-canvas {
  width: 260rpx; height: 260rpx;
}

/* 右侧图例 */
.donut-legend {
  flex: 1; display: flex; flex-direction: column; gap: 16rpx;
}
.dl-item {
  display: flex; align-items: center; gap: 12rpx;
}
.dl-dot {
  width: 14rpx; height: 14rpx; border-radius: 4rpx; flex-shrink: 0;
}
.dl-label {
  font-size: 26rpx; color: #475569; min-width: 80rpx; font-weight: 500;
}
.dl-value {
  font-size: 26rpx; font-weight: 700; color: #1e293b;
  min-width: 50rpx; text-align: right;
  font-variant-numeric: tabular-nums;
}
.dl-pct {
  font-size: 24rpx; color: #94a3b8;
  min-width: 72rpx; text-align: right;
}

/* ============================================================
   Card 2 — 横向柱状图
   ============================================================ */
.hbar-list {
  display: flex; flex-direction: column; gap: 18rpx;
}
.hbar-row {
  display: flex; align-items: center; gap: 16rpx;
}
.hbar-label {
  font-size: 26rpx; font-weight: 600; color: #475569;
  min-width: 108rpx; flex-shrink: 0;
}
.hbar-track {
  flex: 1; height: 36rpx; background: #f1f5f9;
  border-radius: 18rpx; overflow: hidden;
}
.hbar-fill {
  height: 100%; border-radius: 18rpx;
  background: linear-gradient(90deg, #1296db, #38bdf8);
}
.hbar-val {
  font-size: 24rpx; font-weight: 800; color: #1e293b;
  min-width: 48rpx; text-align: right; flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* ============================================================
   Card 3 — 折线图
   ============================================================ */
.line-canvas-wrap {
  width: 100%; height: 420rpx;
}
.line-canvas {
  width: 100%; height: 420rpx;
}
