<navigation-bar title="公告管理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">

  <view class="wrap">
    <!-- 发布表单 -->
    <view class="section-card publish-card">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon pub-icon">📝</view>
          <view class="sec-head-text">
            <text class="sec-title">发布公告</text>
            <text class="sec-sub">向社区居民推送通知消息</text>
          </view>
        </view>
      </view>

      <view class="pub-form">
        <view class="pub-field">
          <text class="pub-label">公告类型</text>
          <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onPickType">
            <view class="pub-picker">
              <text>{{types[typeIndex]}}</text>
              <text class="pub-picker-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="pub-field">
          <text class="pub-label">标题</text>
          <input placeholder="请输入公告标题" value="{{form.title}}" bindinput="onTitle" />
        </view>

        <view class="pub-field">
          <text class="pub-label">正文内容</text>
          <textarea placeholder="请输入公告正文..." value="{{form.content}}" bindinput="onContent" />
        </view>

        <view class="pub-switches">
          <view class="pub-switch-row">
            <view class="pub-switch-info">
              <text class="pub-switch-label">📌 置顶公告</text>
              <text class="pub-switch-desc">始终在列表顶部显示</text>
            </view>
            <switch checked="{{form.pinned}}" bindchange="onPinned" color="#3b82f6" />
          </view>
          <view class="pub-switch-row">
            <view class="pub-switch-info">
              <text class="pub-switch-label">⚠️ 重要公告</text>
              <text class="pub-switch-desc">强提醒并跟踪已读状态</text>
            </view>
            <switch checked="{{form.important}}" bindchange="onImportant" color="#ef4444" />
          </view>
        </view>

        <button class="pub-submit-btn" loading="{{publishing}}" bindtap="publish">
          <text wx:if="{{!publishing}}">📢 立即发布</text>
          <text wx:else>发布中...</text>
        </button>
      </view>
    </view>

    <!-- 历史公告 -->
    <view class="section-card list-card">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon list-icon">📋</view>
          <view class="sec-head-text">
            <text class="sec-title">历史公告</text>
            <text class="sec-sub">已发布 {{items.length}} 条</text>
          </view>
        </view>
        <button size="mini" class="btn-mini-ghost" bindtap="load">刷新</button>
      </view>

      <view class="empty-soft" wx:if="{{!items.length}}">
        <text class="empty-soft-icon">📭</text>
        <text class="empty-soft-text">还没有发布过公告</text>
      </view>

      <view wx:else class="notice-list">
        <view wx:for="{{items}}" wx:key="_id" class="notice-item" bindtap="goDetail" data-id="{{item._id}}">
          <view class="ni-left">
            <view class="ni-top">
              <text wx:if="{{item.pinned}}" class="ni-pin">📌 置顶</text>
              <text wx:if="{{item.important}}" class="ni-urgent">●</text>
              <text class="ni-title">{{item.title}}</text>
            </view>
            <view class="ni-bottom">
              <text class="ni-type">{{item.type}}</text>
              <text class="ni-sep">·</text>
              <text class="ni-time">{{format(item.createdAt)}}</text>
            </view>
          </view>
          <text class="ni-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

</scroll-view>
</view>
