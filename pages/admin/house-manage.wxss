/* ============================================================
   区块卡片
   ============================================================ */
.section-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.form-card { border-top: 6rpx solid #3b82f6; }
.list-card { border-top: 6rpx solid #10b981; }

.sec-head {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx;
}
.sec-head-left {
  flex: 1; display: flex; align-items: center; gap: 14rpx;
}
.sec-icon {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.form-icon { background: #eff6ff; }
.list-icon { background: #ecfdf5; }
.sec-head-text { display: flex; flex-direction: column; gap: 2rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.sec-sub  { font-size: 22rpx; color: #94a3b8; }
.btn-mini-ghost {
  font-size: 24rpx; padding: 8rpx 18rpx; border-radius: 10rpx;
  background: #f8fafc; color: #64748b; border: 1rpx solid #e2e8f0;
}

/* 模式切换 */
.mode-switch {
  display: flex; background: #f1f5f9; border-radius: 12rpx; padding: 4rpx;
}
.mode-opt {
  padding: 10rpx 24rpx; font-size: 24rpx; border-radius: 10rpx;
  color: #64748b; font-weight: 500; transition: all 0.2s;
}
.mode-opt.on {
  background: #fff; color: #2563eb; font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* ============================================================
   表单
   ============================================================ */
.hm-form { display: flex; flex-direction: column; gap: 18rpx; }
.hm-form-row { display: flex; gap: 16rpx; }
.flex-1 { flex: 1; }
.hm-field { display: flex; flex-direction: column; gap: 8rpx; }
.hm-label { font-size: 26rpx; font-weight: 600; color: #475569; }
.hm-field input, .hm-field textarea {
  width: 100%; padding: 16rpx 18rpx; border-radius: 12rpx;
  background: #f8fafc; border: 1rpx solid #e2e8f0;
  box-sizing: border-box; font-size: 28rpx; color: #1e293b;
  min-height: 76rpx; line-height: 1.4;
}
.hm-field textarea { min-height: 160rpx; line-height: 1.5; }

.hm-hint {
  display: flex; align-items: flex-start; gap: 8rpx;
  padding: 14rpx 18rpx; border-radius: 12rpx;
  background: #f0f9ff; border: 1rpx solid #bae6fd;
}
.hm-hint-icon { font-size: 24rpx; flex-shrink: 0; }
.hm-hint-text { font-size: 24rpx; color: #0369a1; line-height: 1.5; }

.hm-submit {
  height: 84rpx; line-height: 84rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff; font-size: 30rpx; font-weight: 700;
  border: none; letter-spacing: 1rpx;
  box-shadow: 0 6rpx 20rpx rgba(59,130,246,0.2);
}
.hm-submit:active { opacity: 0.9; }

.hm-result {
  padding: 16rpx 20rpx; border-radius: 12rpx;
  background: #f0fdf4; border: 1rpx solid #bbf7d0;
}
.hm-result-text { font-size: 26rpx; color: #166534; font-weight: 500; }

/* ============================================================
   列表
   ============================================================ */
.hm-loading { text-align: center; padding: 30rpx; }
.hm-table {
  display: flex; flex-direction: column; gap: 8rpx; margin-top: 12rpx;
}
.hm-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 20rpx; border-radius: 14rpx;
  background: #fbfdff; border: 1rpx solid #f1f5f9; gap: 16rpx;
}
.hm-row-left { flex: 1; overflow: hidden; }
.hm-row-addr {
  font-size: 28rpx; font-weight: 500; color: #1e293b;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.hm-row-del {
  flex-shrink: 0; border-radius: 10rpx; font-size: 24rpx;
  padding: 8rpx 20rpx; background: #fff; color: #ef4444;
  border: 1rpx solid #fecaca;
}
.hm-row-del:active { background: #fef2f2; }

/* ============================================================
   空状态
   ============================================================ */
.empty-soft {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0 28rpx; gap: 8rpx;
}
.empty-soft-icon { font-size: 56rpx; }
.empty-soft-text { font-size: 26rpx; color: #94a3b8; }
.empty-soft-sub  { font-size: 24rpx; color: #cbd5e1; }

.wrap { padding: 18rpx 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
