<navigation-bar title="待办处理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">

  <!-- 概览横幅 -->
  <view class="todo-banner">
    <view class="banner-bg"></view>
    <view class="banner-inner">
      <view class="banner-stat">
        <view class="banner-ring repair-ring"><text class="banner-num">{{repairTodos.length}}</text></view>
        <text class="banner-label">报修待处理</text>
      </view>
      <view class="banner-divider"></view>
      <view class="banner-stat">
        <view class="banner-ring sos-ring"><text class="banner-num">{{sosTodos.length}}</text></view>
        <text class="banner-label">求助待处理</text>
      </view>
      <view class="banner-divider"></view>
      <view class="banner-stat">
        <view class="banner-ring help-ring"><text class="banner-num">{{helpReviewTodos.length}}</text></view>
        <text class="banner-label">互助待审核</text>
      </view>
    </view>
  </view>

  <view class="wrap">
    <!-- Tab切换 -->
    <view class="seg-row">
      <view class="seg-item {{tab==='repair'?'on':''}}" bindtap="setTab" data-tab="repair">报修工单</view>
      <view class="seg-item {{tab==='sos'?'on':''}}" bindtap="setTab" data-tab="sos">紧急求助</view>
      <view class="seg-item {{tab==='help'?'on':''}}" bindtap="setTab" data-tab="help">互助审核</view>
    </view>

    <!-- 报修待办 -->
    <view class="section-card" wx:if="{{tab==='repair'}}">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon repair-icon">🔧</view>
          <view class="sec-head-text">
            <text class="sec-title">报修工单</text>
            <text class="sec-sub">待受理 · 处理中 · 待确认</text>
          </view>
        </view>
        <button size="mini" class="btn-mini-ghost" bindtap="load">刷新</button>
      </view>
      <view class="empty-soft" wx:if="{{!repairTodos.length}}"><text class="empty-soft-icon">🎉</text><text class="empty-soft-text">暂无待办报修</text></view>
      <view class="todo-list" wx:else>
        <view wx:for="{{repairTodos}}" wx:key="_id" class="todo-row" bindtap="goRepair" data-id="{{item._id}}">
          <view class="todo-row-left">
            <view class="todo-dot {{item.status}}"></view>
            <view class="todo-info">
              <text class="todo-row-title">{{item.title || item.category}}</text>
              <view class="todo-row-meta">
                <text class="meta-tag">{{item.category}}</text><text class="meta-sep">·</text><text class="meta-time">{{format(item.createdAt)}}</text>
              </view>
            </view>
          </view>
          <view class="status-pill {{item.status}}">{{statusText(item.status)}}</view>
        </view>
      </view>
    </view>

    <!-- 求助待办 -->
    <view class="section-card sos-section" wx:if="{{tab==='sos'}}">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon sos-icon">🆘</view>
          <view class="sec-head-text"><text class="sec-title">紧急求助</text><text class="sec-sub">需立即响应处理</text></view>
        </view>
        <button size="mini" class="btn-mini-ghost" bindtap="load">刷新</button>
      </view>
      <view class="empty-soft" wx:if="{{!sosTodos.length}}"><text class="empty-soft-icon">✅</text><text class="empty-soft-text">暂无紧急求助</text></view>
      <view class="sos-list" wx:else>
        <view wx:for="{{sosTodos}}" wx:key="_id" class="sos-card-item">
          <view class="sos-card-top">
            <view class="sos-avatar">{{item.fromName ? item.fromName[0] : '?'}}</view>
            <view class="sos-card-info">
              <text class="sos-card-name">{{item.fromName || '匿名用户'}}</text>
              <text class="sos-card-note">{{item.note || '发出了紧急求助信号'}}</text>
            </view>
            <text class="sos-card-time">{{format(item.createdAt)}}</text>
          </view>
          <view class="sos-card-actions">
            <button size="mini" class="btn-action-outline" bindtap="setSos" data-id="{{item._id}}" data-status="processing">📋 受理</button>
            <button size="mini" class="btn-action-solid" bindtap="setSos" data-id="{{item._id}}" data-status="done">✅ 完成</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 互助审核 -->
    <view class="section-card" wx:if="{{tab==='help'}}">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon" style="background:#fffbeb">🤝</view>
          <view class="sec-head-text"><text class="sec-title">互助任务审核</text><text class="sec-sub">审核居民发布的任务</text></view>
        </view>
        <button size="mini" class="btn-mini-ghost" bindtap="load">刷新</button>
      </view>
      <view class="empty-soft" wx:if="{{!helpReviewTodos.length}}"><text class="empty-soft-icon">✅</text><text class="empty-soft-text">暂无待审核的互助任务</text></view>
      <view class="todo-list" wx:else>
        <view wx:for="{{helpReviewTodos}}" wx:key="_id" class="help-review-item">
          <view class="hc-top">
            <view class="hc-info">
              <text class="hc-title">{{item.title}}</text>
              <text class="hc-desc">{{item.content || '暂无描述'}}</text>
            </view>
            <view class="hc-reward">🪙 {{item.rewardPoints}} 积分</view>
          </view>
          <view class="hc-bottom">
            <text class="hc-type">{{item.type}}</text>
            <text class="hc-sep">·</text>
            <text>{{format(item.createdAt)}}</text>
          </view>
          <view class="hc-review-actions">
            <button size="mini" class="act-btn fill-green" bindtap="reviewHelp" data-id="{{item._id}}" data-approve="{{true}}">审核通过</button>
            <button size="mini" class="act-btn outline" bindtap="reviewHelp" data-id="{{item._id}}" data-approve="{{false}}">拒绝</button>
          </view>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
</view>
