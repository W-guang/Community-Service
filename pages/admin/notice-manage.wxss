/* ============================================================
   区块卡片
   ============================================================ */
.section-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.publish-card { border-top: 6rpx solid #3b82f6; }
.list-card    { border-top: 6rpx solid #8b5cf6; }

.sec-head {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx;
}
.sec-head-left {
  flex: 1; display: flex; align-items: center; gap: 14rpx;
}
.sec-icon {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.pub-icon  { background: #eff6ff; }
.list-icon { background: #f5f3ff; }
.sec-head-text {
  display: flex; flex-direction: column; gap: 2rpx;
}
.sec-title {
  font-size: 32rpx; font-weight: 700; color: #1e293b;
}
.sec-sub {
  font-size: 22rpx; color: #94a3b8;
}
.btn-mini-ghost {
  font-size: 24rpx; padding: 8rpx 18rpx; border-radius: 10rpx;
  background: #f8fafc; color: #64748b; border: 1rpx solid #e2e8f0;
}

/* ============================================================
   表单
   ============================================================ */
.pub-form {
  display: flex; flex-direction: column; gap: 20rpx;
}
.pub-field {
  display: flex; flex-direction: column; gap: 10rpx;
}
.pub-label {
  font-size: 26rpx; font-weight: 600; color: #475569;
}
.pub-picker {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 20rpx; border-radius: 14rpx;
  background: #f8fafc; border: 1rpx solid #e2e8f0;
  font-size: 28rpx; color: #1e293b;
}
.pub-picker-arrow { font-size: 22rpx; color: #94a3b8; }

input, textarea {
  width: 100%; padding: 18rpx 20rpx; border-radius: 14rpx;
  background: #f8fafc; border: 1rpx solid #e2e8f0;
  box-sizing: border-box; font-size: 28rpx; color: #1e293b;
  min-height: 80rpx; line-height: 1.4;
}
textarea { min-height: 220rpx; line-height: 1.5; }

/* 开关区域 */
.pub-switches {
  display: flex; flex-direction: column; gap: 4rpx;
}
.pub-switch-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; border-radius: 14rpx;
  background: #f8fafc;
}
.pub-switch-info {
  display: flex; flex-direction: column; gap: 2rpx;
}
.pub-switch-label {
  font-size: 26rpx; font-weight: 600; color: #475569;
}
.pub-switch-desc {
  font-size: 22rpx; color: #94a3b8;
}

/* 发布按钮 */
.pub-submit-btn {
  height: 88rpx; line-height: 88rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff; font-size: 30rpx; font-weight: 700;
  border: none; letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(59,130,246,0.25);
}
.pub-submit-btn:active { opacity: 0.9; }

/* ============================================================
   公告列表
   ============================================================ */
.notice-list {
  display: flex; flex-direction: column; gap: 8rpx;
}
.notice-item {
  display: flex; align-items: center; padding: 22rpx 20rpx;
  border-radius: 14rpx; background: #fbfdff;
  border: 1rpx solid #f1f5f9; gap: 12rpx;
}
.notice-item:active { background: #f5f3ff; border-color: #ddd6fe; }
.ni-left { flex: 1; overflow: hidden; }
.ni-top {
  display: flex; align-items: center; gap: 6rpx;
  overflow: hidden;
}
.ni-pin {
  flex-shrink: 0; font-size: 20rpx; padding: 2rpx 8rpx;
  border-radius: 6rpx; background: #dbeafe; color: #1e40af; font-weight: 700;
}
.ni-urgent {
  flex-shrink: 0; color: #ef4444; font-size: 18rpx;
}
.ni-title {
  font-size: 28rpx; font-weight: 600; color: #1e293b;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ni-bottom {
  display: flex; align-items: center; gap: 6rpx; margin-top: 8rpx;
}
.ni-type {
  font-size: 22rpx; color: #3b82f6; font-weight: 600;
}
.ni-sep { color: #cbd5e1; font-size: 22rpx; }
.ni-time { font-size: 22rpx; color: #94a3b8; }
.ni-arrow {
  font-size: 42rpx; color: #cbd5e1; flex-shrink: 0; font-weight: 300;
}

/* ============================================================
   空状态
   ============================================================ */
.empty-soft {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0 28rpx; gap: 10rpx;
}
.empty-soft-icon { font-size: 56rpx; }
.empty-soft-text { font-size: 26rpx; color: #94a3b8; }

.wrap { padding: 18rpx 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
