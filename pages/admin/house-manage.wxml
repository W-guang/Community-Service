<navigation-bar title="房屋信息管理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">

    <!-- 录入表单 -->
    <view class="card">
      <view class="row">
        <view class="section-title">录入房屋</view>
        <button size="mini" bindtap="toggleBatch">{{batchMode ? '切回单个' : '切换批量'}}</button>
      </view>

      <!-- 小区/楼栋/单元 —— 切换模式时不变 -->
      <view class="field mt">
        <view class="label">小区名称</view>
        <input placeholder="例如：学府小区" value="{{community}}" bindinput="onCommunity" />
      </view>
      <view class="field">
        <view class="label">楼栋号</view>
        <input placeholder="例如：3号楼" value="{{building}}" bindinput="onBuilding" />
      </view>
      <view class="field">
        <view class="label">单元号</view>
        <input placeholder="例如：2单元" value="{{unit}}" bindinput="onUnit" />
      </view>

      <!-- 批量模式：房号列表 -->
      <view wx:if="{{batchMode}}">
        <view class="field">
          <view class="label">房号列表（逗号或换行分隔）</view>
          <textarea placeholder="例如：101,102,103,201,202" value="{{batchRooms}}" bindinput="onBatchRooms" style="height:120rpx;padding:16rpx;border-radius:14rpx;background:#f3f4f6;width:100%;box-sizing:border-box" />
        </view>
        <view class="muted">用逗号、空格或换行分隔房号，例如 101,102,103</view>
      </view>

      <!-- 单个模式：房号 -->
      <view wx:else>
        <view class="field">
          <view class="label">房号</view>
          <input placeholder="例如：1202" value="{{room}}" bindinput="onRoom" />
        </view>
      </view>

      <button class="btn-primary mt" loading="{{adding}}" bindtap="add">{{batchMode ? '批量添加' : '添加房屋'}}</button>
      <view class="muted mt" wx:if="{{batchResult}}" style="color:#1296db">{{batchResult}}</view>
    </view>

    <!-- 房屋列表 -->
    <view class="card">
      <view class="row">
        <view class="section-title">已录入（共{{total}}条）</view>
        <button size="mini" bindtap="load">刷新</button>
      </view>

      <view wx:if="{{loading}}" class="muted" style="text-align:center;padding:20rpx">加载中...</view>
      <view wx:elif="{{!items.length}}" class="empty-state">
        <text class="empty-icon">🏠</text><text class="muted">暂无房屋数据</text>
      </view>
      <view wx:else class="house-list mt">
        <view wx:for="{{items}}" wx:key="_id" class="house-item">
          <view class="col">
            <view class="title">{{item.community}} {{item.building}} {{item.unit}} {{item.room}}</view>
          </view>
          <button size="mini" bindtap="deleteHouse" data-id="{{item._id}}" data-label="{{item.community}}{{item.building}}{{item.unit}}{{item.room}}">删除</button>
        </view>
      </view>
    </view>

  </view>
</scroll-view>
</view>
