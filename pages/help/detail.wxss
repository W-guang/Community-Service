/* ============================================================
   统一大卡片
   ============================================================ */
.unified-card {
  background: #fff; border-radius: 24rpx; padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-top: 6rpx solid #f59e0b;
}

/* —— 头部 —— */
.uc-head {
  display: flex; align-items: center; justify-content: space-between; gap: 14rpx;
  margin-bottom: 8rpx;
}
.uc-title {
  font-size: 36rpx; font-weight: 800; color: #1e293b; flex: 1;
}
.status-pill {
  flex-shrink: 0; font-size: 22rpx; padding: 6rpx 16rpx;
  border-radius: 999rpx; font-weight: 700;
}
.status-pill.open            { background: #d1fae5; color: #065f46; }
.status-pill.taken           { background: #dbeafe; color: #1e40af; }
.status-pill.waiting_confirm { background: #ede9fe; color: #5b21b6; }
.status-pill.done            { background: #e2e8f0; color: #475569; }
.status-pill.pending_review  { background: #fef3c7; color: #92400e; }
.status-pill.rejected        { background: #fee2e2; color: #991b1b; }
.status-pill.expired         { background: #e2e8f0; color: #64748b; }
.uc-meta {
  display: flex; align-items: center; gap: 6rpx; flex-wrap: wrap;
  font-size: 24rpx; color: #94a3b8; padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.meta-tag { color: #f59e0b; font-weight: 600; }
.meta-sep { color: #cbd5e1; }
.meta-reward { color: #d97706; font-weight: 700; }
.meta-deadline { color: #ef4444; font-weight: 600; }

/* —— 分节 —— */
.uc-section {
  padding-top: 24rpx; padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.uc-section-last { border-bottom: none; padding-bottom: 0; }
.uc-sec-label {
  font-size: 26rpx; font-weight: 700; color: #64748b;
  margin-bottom: 14rpx; letter-spacing: 1rpx;
}

/* —— 时间线 —— */
.timeline { padding: 4rpx 0; }
.tl-item {
  display: flex; align-items: flex-start; padding: 10rpx 0;
  position: relative; margin-left: 10rpx;
}
.tl-item:not(:last-child)::after {
  content: ''; position: absolute; left: 10rpx; top: 28rpx; bottom: -2rpx;
  width: 2rpx; background: #e2e8f0;
}
.tl-item.active:not(:last-child)::after { background: #f59e0b; }
.tl-dot {
  width: 22rpx; height: 22rpx; border-radius: 50%; background: #e2e8f0;
  flex-shrink: 0; margin-right: 16rpx; margin-top: 2rpx;
}
.tl-item.active .tl-dot {
  background: #f59e0b; box-shadow: 0 0 0 6rpx rgba(245,158,11,0.15);
}
.tl-body { flex: 1; }
.tl-label { font-size: 28rpx; font-weight: 600; color: #94a3b8; }
.tl-item.active .tl-label { color: #1e293b; }
.tl-time { font-size: 24rpx; color: #94a3b8; margin-top: 2rpx; }

/* —— 内容 —— */
.uc-content {
  font-size: 28rpx; color: #475569; line-height: 1.6; white-space: pre-wrap;
}

/* 接单人 */
.taker-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 14rpx;
  background: #f8fafc; border: 1rpx solid #f1f5f9;
}
.taker-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: linear-gradient(135deg, #fde68a, #fcd34d);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #92400e; flex-shrink: 0;
}
.taker-name { font-size: 28rpx; font-weight: 600; color: #475569; }

/* —— 操作按钮 —— */
.uc-actions { display: flex; gap: 10rpx; margin-top: 18rpx; flex-wrap: wrap; }
.act-btn {
  flex: 1; min-width: 160rpx; height: 68rpx; line-height: 68rpx;
  font-size: 26rpx; font-weight: 600; border-radius: 14rpx; border: none;
}
.act-btn.fill-yellow {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff; box-shadow: 0 4rpx 14rpx rgba(245,158,11,0.25);
}
.act-btn.fill-green {
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff; box-shadow: 0 4rpx 14rpx rgba(16,185,129,0.25);
}
.act-btn.outline-purple {
  background: #fff; color: #8b5cf6; border: 2rpx solid #ddd6fe;
}
.act-btn:active { opacity: 0.85; }

/* —— 内嵌评价 —— */
.rate-inline {
  margin-top: 20rpx; padding: 22rpx; border-radius: 16rpx;
  background: #fffdf7; border: 2rpx dashed #fde68a;
}
.rate-inline-label { font-size: 26rpx; font-weight: 700; color: #92400e; }
.stars-row { display: flex; gap: 10rpx; margin: 12rpx 0; }
.star { font-size: 52rpx; color: #e2e8f0; }
.star.on { color: #f59e0b; }
.rate-input {
  width: 100%; padding: 16rpx 18rpx; border-radius: 12rpx;
  background: #fff; border: 1rpx solid #e2e8f0; box-sizing: border-box;
  font-size: 28rpx; margin-top: 8rpx;
}
.btn-rate-inline {
  margin-top: 14rpx; height: 72rpx; line-height: 72rpx;
  border-radius: 14rpx; background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff; font-size: 28rpx; font-weight: 700; border: none;
}

/* —— 进度记录 —— */
.uc-empty-note { text-align: center; padding: 40rpx 0 20rpx; font-size: 26rpx; color: #b0b7c3; }
.prog-item {
  display: flex; padding: 12rpx 0; position: relative; margin-left: 4rpx;
}
.prog-item:not(:last-child)::after {
  content: ''; position: absolute; left: 6rpx; top: 26rpx; bottom: 0;
  width: 2rpx; background: #e2e8f0;
}
.prog-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #10b981; flex-shrink: 0; margin-right: 16rpx; margin-top: 4rpx;
}
.prog-body { flex: 1; }
.prog-time { font-size: 22rpx; color: #94a3b8; }
.prog-text { font-size: 28rpx; color: #475569; line-height: 1.5; margin-top: 2rpx; }

.chat-input-row {
  display: flex; gap: 12rpx; align-items: center; margin-top: 16rpx;
}
.chat-input-row input {
  flex: 1; min-height: 72rpx; padding: 14rpx 18rpx;
  border-radius: 14rpx; background: #f8fafc;
  border: 1rpx solid #e2e8f0; box-sizing: border-box; font-size: 28rpx;
}
.btn-send {
  flex-shrink: 0; border-radius: 14rpx; font-size: 26rpx;
  padding: 14rpx 24rpx; background: #f59e0b; color: #fff; border: none;
}

/* 骨架屏 */
.skeleton-card { background: #fff; border-radius: 24rpx; padding: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.wrap { padding: 18rpx 24rpx; }

/* —— 联系电话卡片 —— */
.phone-card {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 2rpx solid #bfdbfe;
}
.phone-icon { font-size: 40rpx; }
.phone-info { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.phone-label { font-size: 22rpx; color: #64748b; }
.phone-number { font-size: 32rpx; font-weight: 800; color: #1e40af; }
.phone-name { font-size: 24rpx; color: #64748b; }
.phone-call {
  font-size: 26rpx; font-weight: 700; color: #fff;
  background: #3b82f6; padding: 12rpx 24rpx; border-radius: 12rpx;
}
