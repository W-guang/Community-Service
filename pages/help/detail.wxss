.wrap {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.mt {
  margin-top: 12rpx;
}
.content {
  color: #111827;
  font-size: 28rpx;
  white-space: pre-wrap;
}
.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.progress {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.composer {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.composer input {
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
}

/* 时间线 */
.timeline { padding: 10rpx 0; }
.tl-item { display: flex; align-items: flex-start; padding: 12rpx 0; position: relative; }
.tl-item:not(:last-child) { padding-bottom: 20rpx; }
.tl-item:not(:last-child)::before { content: ''; position: absolute; left: 9rpx; top: 30rpx; bottom: 0; width: 2rpx; background: #e5e7eb; }
.tl-item.active:not(:last-child)::before { background: #1296db; }
.tl-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #e5e7eb; flex-shrink: 0; margin-right: 16rpx; margin-top: 4rpx; }
.tl-item.active .tl-dot { background: #1296db; box-shadow: 0 0 0 6rpx rgba(18,150,219,0.15); }
.tl-content { flex: 1; }
.tl-title { font-size: 28rpx; font-weight: 600; color: #9ca3af; }
.tl-item.active .tl-title { color: #111827; }
.tl-time { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }

/* 状态标签颜色 */
.tag.status-open { background: #d4edda; color: #155724; }
.tag.status-taken { background: #cce5ff; color: #004085; }
.tag.status-waiting_confirm { background: #e8daef; color: #6c3483; }
.tag.status-done { background: #d4edda; color: #155724; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0; }
.empty-icon { font-size: 60rpx; margin-bottom: 12rpx; }

/* 进度列表项 */
.progress-item { display: flex; padding: 14rpx 0; position: relative; }
.progress-item:not(:last-child)::before { content: ''; position: absolute; left: 5rpx; top: 28rpx; bottom: 0; width: 2rpx; background: #e5e7eb; }
.progress-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #1296db; flex-shrink: 0; margin-right: 16rpx; margin-top: 6rpx; }
.progress-content { flex: 1; }
.progress { padding: 0; border-bottom: none; }

/* 骨架屏 */
.skeleton-card { background: #fff; border-radius: 24rpx; padding: 30rpx; }
.skeleton-line { height: 28rpx; background: linear-gradient(90deg, #e5e7eb 25%, #f3f4f6 50%, #e5e7eb 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 8rpx; margin-bottom: 16rpx; }
.skeleton-line.short { width: 40%; }
.skeleton-line.medium { width: 75%; }
.skeleton-line:last-child { margin-bottom: 0; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

