.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.composer {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.composer input {
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
}

/* 进度列表项 */
.progress-item {
  display: flex;
  padding: 14rpx 0;
  position: relative;
}
.progress-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 28rpx;
  bottom: 0;
  width: 2rpx;
  background: #e5e7eb;
}
.progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1296db;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 6rpx;
}
.progress-content { flex: 1; }
.progress { padding: 0; border-bottom: none; }

/* 评价卡片 */
.rate-card {
  border: 2rpx dashed #1296db;
  background: #f0f9ff;
}
.stars-row {
  display: flex;
  gap: 8rpx;
}
.star {
  font-size: 48rpx;
  color: #ccc;
}
.star.on {
  color: #f59e0b;
}
.rate-input {
  width: 100%;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}
