<navigation-bar title="邻里互助" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">
    <view class="row">
      <!-- 普通模式：三段切换；管理模式：只显示大厅 -->
      <view class="seg" wx:if="{{!adminMode}}">
        <view class="seg-item {{tab==='hall'?'on':''}}" bindtap="setTab" data-tab="hall">任务大厅</view>
        <view class="seg-item {{tab==='mine'?'on':''}}" bindtap="setTab" data-tab="mine">我发布的</view>
        <view class="seg-item {{tab==='taken'?'on':''}}" bindtap="setTab" data-tab="taken">我接的</view>
      </view>
      <view class="muted" wx:else>任务大厅 · {{items.length}} 条</view>
      <button class="btn btn-primary" size="mini" bindtap="goCreate">发布</button>
    </view>

    <view wx:if="{{loading}}" class="card skeleton-card">
      <view class="skeleton-line short"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line medium"></view>
    </view>

    <view wx:elif="{{!items.length}}" class="card empty-state">
      <text class="empty-icon">🤝</text>
      <text class="muted">暂无任务</text>
    </view>

    <view wx:for="{{items}}" wx:key="_id" class="list-item" bindtap="goDetail" data-id="{{item._id}}">
      <view class="row">
        <view class="col">
          <view class="title">{{item.title}}</view>
          <view class="muted">{{item.content}}</view>
        </view>
        <view class="tag status-{{item.status}}">{{statusText(item.status)}}</view>
      </view>
      <view class="row meta">
        <view class="muted">{{format(item.createdAt)}}</view>
        <view class="muted">悬赏：{{item.rewardPoints}} 积分</view>
      </view>
    </view>
  </view>
</scroll-view>
</view>
