<navigation-bar title="互助详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap" wx:if="{{help}}">

    <view class="unified-card">
      <!-- ---------- 头部标题 ---------- -->
      <view class="uc-head">
        <text class="uc-title">{{help.title}}</text>
        <view class="status-pill {{help.status}}">{{statusText(help.status)}}</view>
      </view>
      <view class="uc-meta">
        <text class="meta-tag">{{help.type}}</text>
        <text class="meta-sep">·</text>
        <text>{{format(help.createdAt)}}</text>
        <text class="meta-sep">·</text>
        <text class="meta-reward">🪙 {{help.rewardPoints}} 积分</text>
      </view>

      <!-- ---------- 任务进度 ---------- -->
      <view class="uc-section">
        <view class="uc-sec-label">任务进度</view>
        <view class="timeline">
          <view class="tl-item active">
            <view class="tl-dot"></view>
            <view class="tl-body"><text class="tl-label">已发布</text><text class="tl-time">{{format(help.createdAt)}}</text></view>
          </view>
          <view class="tl-item {{help.status === 'taken' || help.status === 'waiting_confirm' || help.status === 'done' ? 'active' : ''}}">
            <view class="tl-dot"></view>
            <view class="tl-body"><text class="tl-label">已承接</text><text class="tl-time" wx:if="{{help.takerOpenid}}">接单人：{{help.takerName || '已接单'}}</text></view>
          </view>
          <view class="tl-item {{help.status === 'waiting_confirm' || help.status === 'done' ? 'active' : ''}}">
            <view class="tl-dot"></view>
            <view class="tl-body"><text class="tl-label">待确认</text><text class="tl-time" wx:if="{{help.status === 'waiting_confirm' || help.status === 'done'}}">等待发布者确认</text></view>
          </view>
          <view class="tl-item {{help.status === 'done' ? 'active' : ''}}">
            <view class="tl-dot"></view>
            <view class="tl-body"><text class="tl-label">已完成</text><text class="tl-time" wx:if="{{help.status === 'done'}}">任务已关闭</text></view>
          </view>
        </view>
      </view>

      <!-- ---------- 任务描述 ---------- -->
      <view class="uc-section">
        <view class="uc-sec-label">任务描述</view>
        <view class="uc-content">{{help.content || '暂无详细描述'}}</view>

        <view wx:if="{{help.takerOpenid}}" class="taker-row">
          <view class="taker-avatar"><text>🤝</text></view>
          <text class="taker-name">接单人：{{help.takerName || '已接单'}}</text>
        </view>

        <view wx:if="{{canOperate}}" class="uc-actions">
          <button wx:if="{{canTake}}" class="act-btn fill-yellow" bindtap="take">🤝 我要接单</button>
          <button wx:if="{{canWaitingConfirm}}" class="act-btn outline-purple" bindtap="setStatus" data-status="waiting_confirm">我已完成，待确认</button>
          <button wx:if="{{canDone}}" class="act-btn fill-green" bindtap="setStatus" data-status="done">✓ 确认完成</button>
        </view>

        <!-- 评价（嵌入） -->
        <view wx:if="{{showRate}}" class="rate-inline">
          <view class="rate-inline-label">⭐ 评价 {{ratingTarget}}</view>
          <view class="stars-row">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{myRating >= item ? 'on' : ''}}" bindtap="onRateStar" data-star="{{item}}">{{myRating >= item ? '★' : '☆'}}</text>
          </view>
          <input class="rate-input" placeholder="写几句评价（可选）" value="{{rateComment}}" bindinput="onRateComment" />
          <button class="btn-rate-inline" bindtap="submitRate">提交评价</button>
        </view>
      </view>

      <!-- ---------- 进度记录 ---------- -->
      <view class="uc-section uc-section-last">
        <view class="uc-sec-label">进度记录</view>
        <view wx:if="{{!progress.length}}" class="uc-empty-note">暂无进度记录</view>
        <view wx:for="{{progress}}" wx:key="_id" class="prog-item">
          <view class="prog-dot"></view>
          <view class="prog-body">
            <text class="prog-time">{{format(item.createdAt)}}</text>
            <text class="prog-text">{{item.content}}</text>
          </view>
        </view>

        <view class="chat-input-row" wx:if="{{canChat}}">
          <input placeholder="更新进度..." value="{{msg}}" bindinput="onMsg" confirm-type="send" bindconfirm="send" />
          <button size="mini" class="btn-send" loading="{{sending}}" bindtap="send">发送</button>
        </view>
      </view>
    </view>

  </view>

  <view class="wrap" wx:else>
    <view class="skeleton-card">
      <view class="skeleton-line short"></view><view class="skeleton-line"></view><view class="skeleton-line medium"></view>
    </view>
  </view>
</scroll-view>
</view>
