<navigation-bar title="公告详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap" wx:if="{{notice}}">

    <view class="unified-card">
      <!-- ---------- 头部标签 + 状态 ---------- -->
      <view class="nd-head">
        <text class="nd-type">{{notice.type}}</text>
        <text wx:if="{{read}}" class="nd-read-badge">已读 ✓</text>
      </view>

      <!-- ---------- 标题 ---------- -->
      <text class="nd-title">{{notice.title}}</text>
      <view class="nd-meta">
        <text>{{format(notice.createdAt)}}</text>
      </view>

      <!-- ---------- 正文 ---------- -->
      <view class="nd-body">
        <view class="nd-content">{{notice.content}}</view>
      </view>

      <!-- ---------- 触达统计（仅 staff） ---------- -->
      <view class="nd-stats" wx:if="{{isStaff}}">
        <view class="nd-stats-label">📊 触达统计</view>
        <view class="stats-bar-wrap">
          <view class="stats-bar">
            <view class="stats-bar-fill" style="width:{{stats.percent || 0}}%"></view>
          </view>
          <view class="stats-meta-row">
            <text class="stats-text">已读 {{stats.readUsers}} / {{stats.totalUsers}} 人</text>
            <button size="mini" class="btn-refresh" bindtap="loadStats">刷新</button>
          </view>
        </view>
      </view>
    </view>

  </view>

  <view class="wrap" wx:else>
    <view class="skeleton-card">
      <view class="skeleton-line short"></view><view class="skeleton-line"></view><view class="skeleton-line medium"></view>
    </view>
  </view>
</scroll-view>
</view>
