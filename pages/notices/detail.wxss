/* ============================================================
   统一大卡片
   ============================================================ */
.unified-card {
  background: #fff; border-radius: 24rpx; padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-top: 6rpx solid #8b5cf6;
}

/* —— 头部标签 —— */
.nd-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.nd-type {
  font-size: 24rpx; font-weight: 700; padding: 6rpx 18rpx;
  border-radius: 999rpx; background: #f5f3ff; color: #7c3aed;
}
.nd-read-badge {
  font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
  background: #d1fae5; color: #065f46; font-weight: 600;
}

/* —— 标题 + 元数据 —— */
.nd-title {
  display: block; font-size: 38rpx; font-weight: 800; color: #1e293b;
  line-height: 1.4;
}
.nd-meta {
  margin-top: 10rpx; font-size: 24rpx; color: #94a3b8;
  padding-bottom: 24rpx; border-bottom: 1rpx solid #f1f5f9;
}

/* —— 正文 —— */
.nd-body {
  padding-top: 24rpx;
}
.nd-content {
  font-size: 30rpx; color: #475569; line-height: 1.8;
  white-space: pre-wrap;
}

/* —— 触达统计 —— */
.nd-stats {
  margin-top: 28rpx; padding-top: 24rpx;
  border-top: 1rpx solid #f1f5f9;
}
.nd-stats-label {
  font-size: 26rpx; font-weight: 700; color: #64748b;
  margin-bottom: 14rpx;
}
.stats-bar-wrap {}
.stats-bar {
  height: 14rpx; background: #e2e8f0; border-radius: 7rpx; overflow: hidden;
}
.stats-bar-fill {
  height: 100%; border-radius: 7rpx;
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  transition: width 0.5s ease;
}
.stats-meta-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 10rpx;
}
.stats-text { font-size: 24rpx; color: #64748b; }
.btn-refresh {
  font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 10rpx;
  background: #f8fafc; color: #64748b; border: 1rpx solid #e2e8f0;
}

/* 骨架屏 */
.skeleton-card { background: #fff; border-radius: 24rpx; padding: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.wrap { padding: 18rpx 24rpx; }

/* —— 标签徽章 —— */
.nd-badge-pin { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #dbeafe; color: #1e40af; font-weight: 600; margin-left: 6rpx; }
.nd-badge-important { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #fee2e2; color: #dc2626; font-weight: 600; margin-left: 6rpx; }

/* —— 管理员操作按钮 —— */
.nd-admin-actions { display: flex; gap: 10rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #f1f5f9; }
.act-btn { font-size: 26rpx; font-weight: 600; border-radius: 14rpx; border: none; padding: 12rpx 24rpx; }
.act-btn.outline { background: #fff; color: #3b82f6; border: 2rpx solid #bfdbfe; }
.act-btn.outline-danger { background: #fff; color: #ef4444; border: 2rpx solid #fecaca; }
.act-btn.fill { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }

/* —— 编辑面板 —— */
.nd-edit-panel { margin-top: 20rpx; padding: 20rpx; background: #f8fafc; border-radius: 16rpx; }
.nd-edit-panel .field { margin-bottom: 14rpx; }
.nd-edit-panel .label { font-size: 26rpx; color: #64748b; display: block; margin-bottom: 6rpx; }
.nd-edit-panel input, .nd-edit-panel textarea { width: 100%; padding: 14rpx; border-radius: 12rpx; background: #fff; border: 1rpx solid #e2e8f0; box-sizing: border-box; font-size: 28rpx; }
.nd-edit-panel textarea { height: 200rpx; }
.field-row { display: flex; gap: 40rpx; margin: 16rpx 0; }
.checkbox-label { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #475569; }
.edit-actions { display: flex; gap: 10rpx; margin-top: 16rpx; }
