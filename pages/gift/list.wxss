/* 页面底色 */
.page {
  background: linear-gradient(180deg, #e8f5e9 0%, #f7f9fa 15%, #f7f9fa 100%);
}

/* 分类标签栏 */
.g-cat-scroll {
  padding: 14rpx 24rpx 8rpx;
}
.g-cat-row {
  white-space: nowrap; width: 100%;
}
.g-cat-item {
  display: inline-block; padding: 12rpx 28rpx; margin-right: 14rpx;
  border-radius: 999rpx; font-size: 26rpx; color: #64748b;
  background: #fff; font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.g-cat-item.on {
  background: linear-gradient(135deg, #e53935, #ff5252);
  color: #fff; font-weight: 700;
}

/* 网格 */
.wrap {
  padding: 14rpx 24rpx 30rpx;
}
.g-empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 80rpx 0; gap: 12rpx;
}
.g-empty-icon { font-size: 72rpx; }
.g-empty-text { font-size: 28rpx; color: #94a3b8; }

.g-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
}

/* 卡片 */
.g-card {
  background: #fff; border-radius: 18rpx; overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.03);
}
.g-card:active { opacity: 0.85; }

.g-card-img {
  width: 100%; height: 280rpx; background: #f8f8f8;
  position: relative;
  display: flex; align-items: center; justify-content: center;
}
.g-card-img image {
  display: block;
}
.g-card-emoji {
  font-size: 72rpx; color: #d1d5db;
}
.g-card-tag {
  position: absolute; left: 14rpx; top: 14rpx;
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx;
  background: linear-gradient(135deg, #e53935, #ff5252);
  color: #fff; font-weight: 700;
}

.g-card-body {
  padding: 18rpx 18rpx 20rpx;
}
.g-card-name {
  display: block; font-size: 28rpx; font-weight: 600; color: #1e293b;
  line-height: 1.3; margin-bottom: 14rpx;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.g-card-bottom {
  display: flex; align-items: center; justify-content: space-between;
}
.g-card-points {
  font-size: 26rpx; color: #e53935; font-weight: 700;
}
.g-card-price {
  font-size: 24rpx; color: #94a3b8; text-decoration: line-through;
}
