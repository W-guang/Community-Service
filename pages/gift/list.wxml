<navigation-bar title="爱心礼遇" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">

  <!-- 分类 Tab -->
  <view class="g-cat-scroll">
    <scroll-view scroll-x="true" show-scrollbar="{{false}}" class="g-cat-row">
      <view wx:for="{{categories}}" wx:key="*this"
            class="g-cat-item {{activeCategory === item ? 'on' : ''}}"
            bindtap="onTab" data-cat="{{item}}">{{item}}</view>
    </scroll-view>
  </view>

  <!-- 礼品网格 -->
  <view class="wrap">
    <view wx:if="{{!filtered.length}}" class="g-empty">
      <text class="g-empty-icon">🎁</text>
      <text class="g-empty-text">该分类暂无礼品</text>
    </view>

    <view wx:else class="g-grid">
      <view wx:for="{{filtered}}" wx:key="name" class="g-card">
        <view class="g-card-img">
          <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFit" style="width:100%;height:100%" />
          <text wx:else class="g-card-emoji">🎁</text>
          <view wx:if="{{item.tag}}" class="g-card-tag">{{item.tag}}</view>
        </view>
        <view class="g-card-body">
          <text class="g-card-name">{{item.name}}</text>
          <view class="g-card-bottom">
            <text class="g-card-points">❤️ {{item.points}} 积分</text>
            <text class="g-card-price">¥{{item.price}}</text>
          </view>
          <view class="g-card-btn" catchtap="onRedeem" data-item="{{item}}">立即兑换</view>
        </view>
      </view>
    </view>
  </view>

</scroll-view>
</view>
