/* ============================================================
   统一大卡片
   ============================================================ */
.unified-card {
  background: #fff; border-radius: 24rpx; padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-top: 6rpx solid #3b82f6;
}

/* —— 头部 —— */
.uc-head {
  display: flex; align-items: center; justify-content: space-between; gap: 14rpx;
  margin-bottom: 8rpx;
}
.uc-title {
  font-size: 36rpx; font-weight: 800; color: #1e293b; flex: 1;
}
.status-pill {
  flex-shrink: 0; font-size: 22rpx; padding: 6rpx 16rpx;
  border-radius: 999rpx; font-weight: 700;
}
.status-pill.pending        { background: #fef3c7; color: #92400e; }
.status-pill.processing      { background: #dbeafe; color: #1e40af; }
.status-pill.waiting_confirm { background: #ede9fe; color: #5b21b6; }
.status-pill.done            { background: #d1fae5; color: #065f46; }
.uc-meta {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 24rpx; color: #94a3b8; padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.meta-cat { color: #3b82f6; font-weight: 600; }
.meta-sep { color: #cbd5e1; }

/* —— 分节 —— */
.uc-section {
  padding-top: 24rpx; padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.uc-section-last { border-bottom: none; padding-bottom: 0; }
.uc-sec-label {
  font-size: 26rpx; font-weight: 700; color: #64748b;
  margin-bottom: 14rpx; letter-spacing: 1rpx;
}

/* —— 时间线 —— */
.timeline { padding: 4rpx 0; }
.tl-item {
  display: flex; align-items: flex-start; padding: 10rpx 0;
  position: relative; margin-left: 10rpx;
}
.tl-item:not(:last-child)::after {
  content: ''; position: absolute; left: 10rpx; top: 28rpx; bottom: -2rpx;
  width: 2rpx; background: #e2e8f0;
}
.tl-item.active:not(:last-child)::after { background: #3b82f6; }
.tl-dot {
  width: 22rpx; height: 22rpx; border-radius: 50%; background: #e2e8f0;
  flex-shrink: 0; margin-right: 16rpx; margin-top: 2rpx;
}
.tl-item.active .tl-dot {
  background: #3b82f6; box-shadow: 0 0 0 6rpx rgba(59,130,246,0.15);
}
.tl-body { flex: 1; }
.tl-label { font-size: 28rpx; font-weight: 600; color: #94a3b8; }
.tl-item.active .tl-label { color: #1e293b; }
.tl-time { font-size: 24rpx; color: #94a3b8; margin-top: 2rpx; }

/* —— 内容 —— */
.uc-content {
  font-size: 28rpx; color: #475569; line-height: 1.6; white-space: pre-wrap;
}
.uc-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.uc-img { width: 200rpx; height: 200rpx; border-radius: 14rpx; background: #e2e8f0; }
.uc-loc {
  display: flex; align-items: center; gap: 8rpx;
  margin-top: 12rpx; padding: 14rpx 18rpx; border-radius: 12rpx;
  background: #f8fafc; font-size: 26rpx; color: #64748b;
}

/* —— 操作按钮 —— */
.uc-actions { display: flex; gap: 10rpx; margin-top: 18rpx; flex-wrap: wrap; }
.act-btn {
  flex: 1; min-width: 160rpx; height: 68rpx; line-height: 68rpx;
  font-size: 26rpx; font-weight: 600; border-radius: 14rpx; border: none;
}
.act-btn.outline        { background: #fff; color: #3b82f6; border: 2rpx solid #bfdbfe; }
.act-btn.outline-purple { background: #fff; color: #8b5cf6; border: 2rpx solid #ddd6fe; }
.act-btn.fill           { background: linear-gradient(135deg, #10b981, #059669); color: #fff; box-shadow: 0 4rpx 14rpx rgba(16,185,129,0.25); }
.act-btn:active { opacity: 0.85; }

/* —— 沟通区（评论区样式，全部左对齐）—— */
.uc-empty-note { text-align: center; padding: 40rpx 0 20rpx; font-size: 26rpx; color: #b0b7c3; }
.comment-item { margin-bottom: 14rpx; }
.comment-bubble {
  max-width: 100%; border-radius: 16rpx; padding: 16rpx 20rpx;
  display: flex; flex-direction: column; gap: 4rpx;
}
.bub-resident { background: #eff6ff; border-bottom-left-radius: 6rpx; }
.bub-staff    { background: #ecfdf5; border-bottom-left-radius: 6rpx; }
.comment-header {
  display: flex; align-items: center; justify-content: space-between;
}
.comment-from { font-size: 22rpx; font-weight: 700; color: #64748b; }
.comment-time { font-size: 20rpx; color: #94a3b8; }
.comment-text { font-size: 28rpx; color: #1e293b; line-height: 1.5; }
.chat-input-row {
  display: flex; gap: 12rpx; align-items: center; margin-top: 16rpx;
}
.chat-input-row input {
  flex: 1; min-height: 72rpx; padding: 14rpx 18rpx;
  border-radius: 14rpx; background: #f8fafc;
  border: 1rpx solid #e2e8f0; box-sizing: border-box; font-size: 28rpx;
}
.btn-send {
  flex-shrink: 0; border-radius: 14rpx; font-size: 26rpx;
  padding: 14rpx 24rpx; background: #3b82f6; color: #fff; border: none;
}

/* —— 房屋信息行 —— */
.house-info-row { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 18rpx; background: #f0f9ff; border-radius: 12rpx; font-size: 26rpx; color: #1e40af; }

/* 骨架屏 */
.skeleton-card { background: #fff; border-radius: 24rpx; padding: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.wrap { padding: 18rpx 24rpx; }
