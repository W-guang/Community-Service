.imgs {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #e5e7eb;
}
.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}
.name {
  font-weight: 600;
  color: #111827;
}
.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.loc-icon {
  font-size: 28rpx;
}
.composer {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.composer input {
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
}
