/* ============================================================
   区块
   ============================================================ */
.section-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-top: 6rpx solid #3b82f6;
}
.sec-head {
  display: flex; align-items: center; gap: 14rpx; margin-bottom: 20rpx;
}
.sec-head-left { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.sec-icon {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  background: #eff6ff; display: flex; align-items: center;
  justify-content: center; font-size: 28rpx; flex-shrink: 0;
}
.sec-head-text { display: flex; flex-direction: column; gap: 2rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.sec-sub  { font-size: 22rpx; color: #94a3b8; }

/* ============================================================
   表单
   ============================================================ */
.form { display: flex; flex-direction: column; gap: 22rpx; }
.field { display: flex; flex-direction: column; gap: 10rpx; }
.label { font-size: 26rpx; font-weight: 600; color: #475569; }
.picker {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 20rpx; border-radius: 14rpx;
  background: #f8fafc; border: 1rpx solid #e2e8f0;
  font-size: 28rpx; color: #1e293b;
}
.picker-arrow { font-size: 22rpx; color: #94a3b8; }

.loc-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; padding: 18rpx 20rpx; border-radius: 14rpx;
  background: #f8fafc; border: 1rpx solid #e2e8f0;
}
.loc-text { flex: 1; font-size: 26rpx; color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.btn-loc {
  flex-shrink: 0; font-size: 24rpx; padding: 8rpx 18rpx; border-radius: 10rpx;
  background: #eff6ff; color: #3b82f6; border: 1rpx solid #bfdbfe;
}

/* 图片区 */
.imgs { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-wrap {
  width: 200rpx; height: 200rpx; position: relative; border-radius: 16rpx; overflow: hidden;
}
.img { width: 100%; height: 100%; background: #e2e8f0; }
.img-del {
  position: absolute; right: 8rpx; top: 8rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(0,0,0,0.55); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; line-height: 1;
}
.img-add {
  width: 200rpx; height: 200rpx; border-radius: 16rpx;
  border: 3rpx dashed #cbd5e1; background: #f8fafc;
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 6rpx;
}
.img-add-icon { font-size: 52rpx; color: #94a3b8; line-height: 1; }
.img-add-text { font-size: 22rpx; color: #94a3b8; }

/* 提交按钮 */
.btn-submit {
  margin-top: 4rpx; height: 88rpx; line-height: 88rpx;
  border-radius: 18rpx; background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff; font-size: 30rpx; font-weight: 700;
  border: none; letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(59,130,246,0.25);
}
.btn-submit:active { opacity: 0.9; }

.wrap { padding: 18rpx 24rpx; }
