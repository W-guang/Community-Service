<navigation-bar title="{{adminMode ? '工单管理' : '报修'}}" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">
    <!-- 管理模式：状态筛选栏 -->
    <view class="filter-row" wx:if="{{adminMode}}">
      <view class="filter-tag {{filterStatus===''?'on':''}}" bindtap="setFilter" data-status="">全部</view>
      <view class="filter-tag {{filterStatus==='pending'?'on':''}}" bindtap="setFilter" data-status="pending">待受理</view>
      <view class="filter-tag {{filterStatus==='processing'?'on':''}}" bindtap="setFilter" data-status="processing">处理中</view>
      <view class="filter-tag {{filterStatus==='waiting_confirm'?'on':''}}" bindtap="setFilter" data-status="waiting_confirm">待确认</view>
      <view class="filter-tag {{filterStatus==='done'?'on':''}}" bindtap="setFilter" data-status="done">已完成</view>
    </view>

    <view class="row" wx:if="{{!adminMode}}">
      <view class="muted">我的报修 · {{items.length}} 条</view>
      <button class="btn btn-primary" size="mini" bindtap="goCreate">新建报修</button>
    </view>
    <view class="row" wx:else>
      <view class="muted">全部工单 · {{items.length}} 条</view>
      <button class="btn btn-primary" size="mini" bindtap="goCreate">新建报修</button>
    </view>

    <view wx:if="{{loading}}" class="card skeleton-card">
      <view class="skeleton-line short"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line medium"></view>
    </view>

    <view wx:elif="{{!items.length}}" class="card empty-state">
      <text class="empty-icon">🔧</text>
      <text class="muted">暂无报修记录</text>
    </view>

    <view wx:for="{{items}}" wx:key="_id" class="list-item" bindtap="goDetail" data-id="{{item._id}}">
      <view class="row">
        <view class="col">
          <view class="title">{{item.title || item.category}}</view>
          <view class="muted">{{item.content}}</view>
        </view>
        <view class="tag status-{{item.status}}">{{statusText(item.status)}}</view>
      </view>
      <view class="meta muted">{{format(item.createdAt)}}</view>
    </view>
  </view>
</scroll-view>
</view>
