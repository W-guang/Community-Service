<navigation-bar title="报修详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
  <view class="wrap" wx:if="{{repair}}">
    <!-- 状态时间线 -->
    <view class="card timeline-card">
      <view class="section-title">工单进度</view>
      <view class="timeline">
        <view class="tl-item {{repair.status === 'pending' || repair.status === 'processing' || repair.status === 'waiting_confirm' || repair.status === 'done' ? 'active' : ''}}">
          <view class="tl-dot"></view>
          <view class="tl-content">
            <view class="tl-title">已提交</view>
            <view class="tl-time">{{format(repair.createdAt)}}</view>
          </view>
        </view>
        <view class="tl-item {{repair.status === 'processing' || repair.status === 'waiting_confirm' || repair.status === 'done' ? 'active' : ''}}">
          <view class="tl-dot"></view>
          <view class="tl-content">
            <view class="tl-title">处理中</view>
            <view class="tl-time" wx:if="{{repair.accepted_at}}">{{format(repair.accepted_at)}}</view>
            <view class="tl-time" wx:elif="{{repair.status === 'processing' || repair.status === 'waiting_confirm' || repair.status === 'done'}}">已受理</view>
          </view>
        </view>
        <view class="tl-item {{repair.status === 'waiting_confirm' || repair.status === 'done' ? 'active' : ''}}">
          <view class="tl-dot"></view>
          <view class="tl-content">
            <view class="tl-title">待确认</view>
            <view class="tl-time" wx:if="{{repair.status === 'waiting_confirm' || repair.status === 'done'}}">等待居民确认</view>
          </view>
        </view>
        <view class="tl-item {{repair.status === 'done' ? 'active' : ''}}">
          <view class="tl-dot"></view>
          <view class="tl-content">
            <view class="tl-title">已完成</view>
            <view class="tl-time" wx:if="{{repair.status === 'done'}}">工单已关闭</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 报修信息 -->
    <view class="card">
      <view class="row">
        <view class="section-title">{{repair.title || repair.category}}</view>
        <view class="tag status-{{repair.status}}">{{statusText(repair.status)}}</view>
      </view>
      <view class="muted">{{format(repair.createdAt)}}</view>
      <view class="content mt">{{repair.content}}</view>

      <view wx:if="{{repair.images && repair.images.length}}" class="imgs">
        <image wx:for="{{repair.images}}" wx:key="*this" class="img" mode="aspectFill" src="{{item}}" bindtap="preview" data-src="{{item}}" />
      </view>

      <view wx:if="{{repair.location}}" class="location-info mt">
        <text class="loc-icon">📍</text>
        <text class="muted">{{repair.location.address || repair.location.name || '已定位'}}</text>
      </view>

      <view wx:if="{{isStaff}}" class="actions">
        <button size="mini" bindtap="setStatus" data-status="processing">接单/处理中</button>
        <button size="mini" bindtap="setStatus" data-status="waiting_confirm">转待确认</button>
        <button size="mini" class="btn-primary" bindtap="setStatus" data-status="done">完成</button>
      </view>
    </view>

    <!-- 沟通记录 -->
    <view class="card">
      <view class="section-title">沟通记录</view>
      <view wx:if="{{!comments.length}}" class="empty-state">
        <text class="empty-icon">💬</text>
        <text class="muted">暂无留言</text>
      </view>
      <view wx:for="{{comments}}" wx:key="_id" class="comment {{item.fromRole === 'resident' ? 'comment-left' : 'comment-right'}}">
        <view class="comment-bubble {{item.fromRole === 'resident' ? 'bubble-resident' : 'bubble-staff'}}">
          <view class="comment-name">{{item.fromName}}</view>
          <view class="comment-text">{{item.content}}</view>
          <view class="comment-time">{{format(item.createdAt)}}</view>
        </view>
      </view>

      <view class="composer">
        <input placeholder="输入留言..." value="{{comment}}" bindinput="onComment" />
        <button size="mini" class="btn-primary" loading="{{sending}}" bindtap="send">发送</button>
      </view>
    </view>
  </view>

  <view class="wrap" wx:else>
    <view class="card skeleton-card">
      <view class="skeleton-line short"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line medium"></view>
    </view>
  </view>
</view>
