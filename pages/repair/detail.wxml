<navigation-bar title="报修详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap" wx:if="{{repair}}">
    <!-- ===== 单张统一大卡片 ===== -->
    <view class="unified-card">
      <!-- ---------- 头部标题 ---------- -->
      <view class="uc-head">
        <text class="uc-title">{{repair.title || repair.category}}</text>
        <view class="status-pill {{repair.status}}">{{statusText(repair.status)}}</view>
      </view>
      <view class="uc-meta">
        <text class="meta-cat">{{repair.category}}</text>
        <text class="meta-sep">·</text>
        <text>{{format(repair.createdAt)}}</text>
      </view>

      <!-- ---------- 房屋信息 ---------- -->
      <view class="uc-section" wx:if="{{repair.house}}">
        <view class="uc-sec-label">报修房屋</view>
        <view class="house-info-row">
          <text>🏠 {{repair.house.community}} {{repair.house.building}}号楼 {{repair.house.unit}}单元 {{repair.house.room}}室</text>
        </view>
      </view>

      <!-- ---------- 进度时间线 ---------- -->
      <view class="uc-section">
        <view class="uc-sec-label">工单进度</view>
        <view class="timeline">
          <view class="tl-item active">
            <view class="tl-dot"></view>
            <view class="tl-body">
              <text class="tl-label">已提交</text>
              <text class="tl-time">{{format(repair.createdAt)}}</text>
            </view>
          </view>
          <view class="tl-item {{repair.status === 'processing' || repair.status === 'waiting_confirm' || repair.status === 'done' ? 'active' : ''}}">
            <view class="tl-dot"></view>
            <view class="tl-body">
              <text class="tl-label">处理中</text>
              <text class="tl-time" wx:if="{{repair.accepted_at}}">{{format(repair.accepted_at)}}</text>
              <text class="tl-time" wx:elif="{{repair.status === 'processing' || repair.status === 'waiting_confirm' || repair.status === 'done'}}">已受理，正在处理</text>
            </view>
          </view>
          <view class="tl-item {{repair.status === 'waiting_confirm' || repair.status === 'done' ? 'active' : ''}}">
            <view class="tl-dot"></view>
            <view class="tl-body">
              <text class="tl-label">待确认</text>
              <text class="tl-time" wx:if="{{repair.status === 'waiting_confirm' || repair.status === 'done'}}">请确认维修结果</text>
            </view>
          </view>
          <view class="tl-item {{repair.status === 'done' ? 'active' : ''}}">
            <view class="tl-dot"></view>
            <view class="tl-body">
              <text class="tl-label">已完成</text>
              <text class="tl-time" wx:if="{{repair.status === 'done'}}">工单已关闭</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ---------- 详细描述 ---------- -->
      <view class="uc-section">
        <view class="uc-sec-label">问题描述</view>
        <view class="uc-content">{{repair.content || '暂无详细描述'}}</view>

        <view wx:if="{{repair.images && repair.images.length}}" class="uc-imgs">
          <image wx:for="{{repair.images}}" wx:key="*this" class="uc-img" mode="aspectFill" src="{{item}}" bindtap="preview" data-src="{{item}}" />
        </view>

        <view wx:if="{{isStaff}}" class="uc-actions">
          <button size="mini" class="act-btn outline" bindtap="setStatus" data-status="processing">接单处理</button>
          <button size="mini" class="act-btn outline-purple" bindtap="setStatus" data-status="waiting_confirm">转待确认</button>
          <button size="mini" class="act-btn fill" bindtap="setStatus" data-status="done">标记完成</button>
        </view>
      </view>

      <!-- ---------- 沟通记录（评论区样式）---------- -->
      <view class="uc-section uc-section-last">
        <view class="uc-sec-label">沟通记录</view>
        <view wx:if="{{!comments.length}}" class="uc-empty-note">暂无留言，在下方发送第一条</view>
        <view wx:for="{{comments}}" wx:key="_id" class="comment-item">
          <view class="comment-bubble {{item.fromRole === 'resident' ? 'bub-resident' : 'bub-staff'}}">
            <view class="comment-header">
              <text class="comment-from">{{item.fromName}}</text>
              <text class="comment-time">{{format(item.createdAt)}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
          </view>
        </view>

        <view class="chat-input-row">
          <input placeholder="输入留言..." value="{{comment}}" bindinput="onComment" confirm-type="send" bindconfirm="send" />
          <button size="mini" class="btn-send" loading="{{sending}}" bindtap="send">发送</button>
        </view>
      </view>
    </view>
  </view>

  <view class="wrap" wx:else>
    <view class="skeleton-card">
      <view class="skeleton-line short"></view><view class="skeleton-line"></view><view class="skeleton-line medium"></view>
    </view>
  </view>
</scroll-view>
</view>
