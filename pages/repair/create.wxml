<navigation-bar title="新建报修" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">

    <view class="section-card">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon"><text>📝</text></view>
          <view class="sec-head-text">
            <text class="sec-title">提交报修工单</text>
            <text class="sec-sub">填写问题信息，物业将尽快处理</text>
          </view>
        </view>
      </view>

      <view class="form">
        <view class="field">
          <text class="label">报修分类</text>
          <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onPickCategory">
            <view class="picker">
              <text>{{categories[categoryIndex]}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="field">
          <text class="label">标题</text>
          <input placeholder="例如：楼道灯不亮、水管漏水" value="{{title}}" bindinput="onTitle" />
        </view>

        <view class="field">
          <text class="label">详细描述</text>
          <textarea placeholder="请描述问题的具体情况、位置等信息..." value="{{content}}" bindinput="onContent" />
        </view>

        <view class="field">
          <text class="label">🏠 选择房屋位置</text>
          <picker wx:if="{{houses.length > 0}}" mode="selector" range="{{houseDisplayList}}" value="{{selectedHouseIndex}}" bindchange="onPickHouse">
            <view class="picker">
              <text wx:if="{{houseDisplayList[selectedHouseIndex]}}">{{houseDisplayList[selectedHouseIndex]}}</text>
              <text wx:else>请选择房屋</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <view wx:else class="picker">
            <text style="color:#999">暂无已绑定的房屋，请先绑定房屋</text>
          </view>
        </view>

        <view class="field">
          <text class="label">📷 现场照片（最多 6 张）</text>
          <view class="imgs">
            <view wx:for="{{images}}" wx:key="*this" class="img-wrap">
              <image class="img" mode="aspectFill" src="{{item}}" />
              <view class="img-del" bindtap="removeImage" data-idx="{{index}}">×</view>
            </view>
            <view wx:if="{{images.length < 6}}" class="img-add" bindtap="addImage">
              <text class="img-add-icon">+</text>
              <text class="img-add-text">添加图片</text>
            </view>
          </view>
        </view>

        <button class="btn-submit" loading="{{submitting}}" bindtap="submit">
          <text wx:if="{{!submitting}}">提交报修</text>
          <text wx:else>提交中...</text>
        </button>
      </view>
    </view>

  </view>
</scroll-view>
</view>
