.page { background: #f0f2f5; min-height: 100vh; }

.wrap { padding: 14rpx 22rpx 30rpx; }

/* 空状态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; gap: 12rpx; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 30rpx; font-weight: 600; color: #64748b; }
.empty-sub { font-size: 24rpx; color: #94a3b8; margin-top: 4rpx; }

/* 列表 */
.list { display: flex; flex-direction: column; gap: 12rpx; }

.card {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 18rpx; padding: 24rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.card:active { background: #f8fafc; }

.card-left { display: flex; flex-direction: column; gap: 6rpx; flex: 1; overflow: hidden; }
.card-name { font-size: 28rpx; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-time { font-size: 22rpx; color: #94a3b8; }

.card-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; flex-shrink: 0; }
.card-points { font-size: 26rpx; font-weight: 700; color: #ef4444; }
.card-status { font-size: 22rpx; font-weight: 600; padding: 4rpx 12rpx; border-radius: 8rpx; }
.card-status.pending { background: #fef3c7; color: #b45309; }
.card-status.fulfilled { background: #d1fae5; color: #065f46; }

/* 加载 */
.loading { display: flex; justify-content: center; padding: 40rpx 0; }
.loading-text { font-size: 26rpx; color: #94a3b8; }
