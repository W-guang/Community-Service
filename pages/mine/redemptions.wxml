<navigation-bar title="兑换记录" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">

    <view wx:if="{{!items.length && !loading}}" class="empty">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无兑换记录</text>
      <text class="empty-sub">去爱心商城兑换好礼吧</text>
    </view>

    <view wx:else class="list">
      <view wx:for="{{items}}" wx:key="_id" class="card">
        <view class="card-left">
          <text class="card-name">{{item.giftName}}</text>
          <text class="card-time">{{item.timeText}}</text>
        </view>
        <view class="card-right">
          <text class="card-points">-{{item.points}} 积分</text>
          <text class="card-status {{item.status}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text class="loading-text">加载中…</text>
    </view>

  </view>
</scroll-view>
</view>
