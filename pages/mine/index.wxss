/* ============================================================
   页面
   ============================================================ */
.page { background: #f0f2f5; }

/* ============================================================
   1. 渐变弥散光头部
   ============================================================ */
.m-header {
  display: flex; flex-direction: column; align-items: center; gap: 0 !important;
  margin: 0 -22rpx;
  padding: 0 32rpx 28rpx;
  background: linear-gradient(160deg, #4f46e5, #6366f1, #7c3aed, #5b21b6, #4c1d95);
  position: relative; overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
}
/* 动态光球 */
.mh-orb {
  position: absolute; border-radius: 50%;
  pointer-events: none; z-index: 0;
}
/* 8 个光球，不同大小/位置/速度 */
.mh-orb-1 { width: 120rpx; height: 120rpx; top: 10%;  left: 60%; background: radial-gradient(circle, rgba(255,255,255,0.18), transparent); animation: orbFloat1 7s ease-in-out infinite; }
.mh-orb-2 { width: 80rpx;  height: 80rpx;  top: 60%;  left: 80%; background: radial-gradient(circle, rgba(167,139,250,0.20), transparent); animation: orbFloat2 9s ease-in-out infinite; }
.mh-orb-3 { width: 100rpx; height: 100rpx; top: 40%;  left: 20%; background: radial-gradient(circle, rgba(255,255,255,0.12), transparent); animation: orbFloat3 11s ease-in-out infinite; }
.mh-orb-4 { width: 60rpx;  height: 60rpx;  top: 70%;  left: 50%; background: radial-gradient(circle, rgba(167,139,250,0.16), transparent); animation: orbFloat4 8s ease-in-out infinite; }
.mh-orb-5 { width: 140rpx; height: 140rpx; top: 5%;   left: 5%;  background: radial-gradient(circle, rgba(255,255,255,0.10), transparent); animation: orbFloat5 10s ease-in-out infinite; }
.mh-orb-6 { width: 90rpx;  height: 90rpx;  top: 25%;  left: 90%; background: radial-gradient(circle, rgba(255,255,255,0.14), transparent); animation: orbFloat2 7.5s ease-in-out infinite; }
.mh-orb-7 { width: 70rpx;  height: 70rpx;  top: 80%;  left: 30%; background: radial-gradient(circle, rgba(167,139,250,0.18), transparent); animation: orbFloat1 12s ease-in-out infinite; }
.mh-orb-8 { width: 110rpx; height: 110rpx; top: 15%;  left: 40%; background: radial-gradient(circle, rgba(255,255,255,0.08), transparent); animation: orbFloat3 8.5s ease-in-out infinite; }
@keyframes orbFloat1 {
  0%,100% { transform: translate(0,0); }
  25% { transform: translate(20rpx,-16rpx); }
  50% { transform: translate(-12rpx,-30rpx); }
  75% { transform: translate(-18rpx,-8rpx); }
}
@keyframes orbFloat2 {
  0%,100% { transform: translate(0,0); }
  25% { transform: translate(-16rpx,-14rpx); }
  50% { transform: translate(10rpx,-24rpx); }
  75% { transform: translate(22rpx,-6rpx); }
}
@keyframes orbFloat3 {
  0%,100% { transform: translate(0,0); }
  33% { transform: translate(-26rpx,-10rpx); }
  66% { transform: translate(14rpx,-22rpx); }
}
@keyframes orbFloat4 {
  0%,100% { transform: translate(0,0); }
  30% { transform: translate(10rpx,-18rpx); }
  60% { transform: translate(-14rpx,-8rpx); }
}
@keyframes orbFloat5 {
  0%,100% { transform: translate(0,0); }
  40% { transform: translate(-8rpx,-20rpx); }
  70% { transform: translate(16rpx,-12rpx); }
}

/* 闪烁微粒 */
.mh-dot {
  position: absolute; border-radius: 50%;
  background: rgba(255,255,255,0.7);
  pointer-events: none; z-index: 1;
}
.mh-dot-1  { width: 4rpx; height: 4rpx; top: 15%; left: 40%; animation: dotTwinkle 2.5s ease-in-out infinite; }
.mh-dot-2  { width: 3rpx; height: 3rpx; top: 30%; left: 70%; animation: dotTwinkle 3.0s ease-in-out infinite 0.4s; }
.mh-dot-3  { width: 5rpx; height: 5rpx; top: 55%; left: 15%; animation: dotTwinkle 2.2s ease-in-out infinite 0.8s; }
.mh-dot-4  { width: 3rpx; height: 3rpx; top: 10%; left: 85%; animation: dotTwinkle 3.5s ease-in-out infinite 0.3s; }
.mh-dot-5  { width: 4rpx; height: 4rpx; top: 75%; left: 60%; animation: dotTwinkle 2.8s ease-in-out infinite 1.0s; }
.mh-dot-6  { width: 3rpx; height: 3rpx; top: 45%; left: 50%; animation: dotTwinkle 3.2s ease-in-out infinite 0.6s; }
.mh-dot-7  { width: 5rpx; height: 5rpx; top: 85%; left: 25%; animation: dotTwinkle 2.0s ease-in-out infinite 1.2s; }
.mh-dot-8  { width: 3rpx; height: 3rpx; top: 20%; left: 10%; animation: dotTwinkle 2.6s ease-in-out infinite 0.2s; }
.mh-dot-9  { width: 4rpx; height: 4rpx; top: 65%; left: 75%; animation: dotTwinkle 3.3s ease-in-out infinite 0.9s; }
.mh-dot-10 { width: 3rpx; height: 3rpx; top: 50%; left: 35%; animation: dotTwinkle 2.4s ease-in-out infinite 1.5s; }
.mh-dot-11 { width: 4rpx; height: 4rpx; top: 90%; left: 90%; animation: dotTwinkle 3.1s ease-in-out infinite 0.7s; }
.mh-dot-12 { width: 3rpx; height: 3rpx; top: 35%; left: 55%; animation: dotTwinkle 2.7s ease-in-out infinite 1.1s; }
@keyframes dotTwinkle {
  0%,100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.mh-avatar {
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: rgba(255,255,255,0.18);
  border: 2rpx solid rgba(255,255,255,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.12);
  position: relative; z-index: 1;
  margin-top: -84rpx !important;
}

.mh-name {
  font-size: 30rpx; font-weight: 700; color: #fff;
  position: relative; z-index: 1;
  margin-top: 16rpx !important;
}

.mh-tag {
  font-size: 22rpx; color: rgba(255,255,255,0.7);
  background: rgba(255,255,255,0.1);
  padding: 6rpx 20rpx; border-radius: 24rpx;
  position: relative; z-index: 1;
  margin-top: 12rpx !important;
}

.mh-stats {
  width: 100%; display: flex;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 20rpx; padding: 12rpx 8rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
  position: relative; z-index: 1;
  margin-top: 26rpx !important;
}
.mhs-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.mhs-num  { font-size: 32rpx; font-weight: 800; color: #fff; }
.mhs-label { font-size: 20rpx; color: rgba(255,255,255,0.6); }

/* ============================================================
   2. 快速入口
   ============================================================ */
.m-grid {
  display: flex; justify-content: space-between; gap: 12rpx;
}

.mg-item {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 14rpx;
  background: #fff; border-radius: 24rpx; padding: 30rpx 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.mg-item:active { background: #f8fafc; }

.mgi-badge {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.bg-amber { background: #fffbeb; }
.bg-rose  { background: #fff1f2; }
.bg-mint  { background: #ecfdf5; }

.mgi-text { font-size: 26rpx; font-weight: 600; color: #334155; }

/* ============================================================
   3. 模式切换
   ============================================================ */
.m-mode-card {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #f5f3ff, #fff);
  border: 1rpx solid #ede9fe;
  border-radius: 20rpx; padding: 22rpx 24rpx;
}
.m-mode-card:active { background: #ede9fe; }
.mm-left { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.mm-icon { font-size: 32rpx; }
.mm-text { font-size: 28rpx; font-weight: 600; color: #5b21b6; }
.mm-arrow { font-size: 34rpx; color: #a78bfa; }

/* ============================================================
   4. 功能菜单
   ============================================================ */
.m-menu {
  background: #fff; border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  overflow: hidden;
}
.mm-item {
  display: flex; align-items: center; gap: 16rpx; padding: 28rpx 22rpx;
}
.mm-item:active { background: #f8fafc; }
.mm-item + .mm-item { border-top: 1rpx solid #f1f5f9; }
.mmi-icon {
  width: 50rpx; height: 50rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; flex-shrink: 0;
}
.bg-red  { background: #fef2f2; color: #ef4444; }
.bg-blue { background: #eff6ff; color: #3b82f6; }
.bg-green { background: #f0fdf4; color: #22c55e; }
.bg-purple { background: #f5f3ff; color: #8b5cf6; }

.mmi-text { flex: 1; font-size: 28rpx; font-weight: 600; color: #334155; }
.mmi-arrow { font-size: 34rpx; color: #cbd5e1; }

/* ============================================================
   5. 老人模式
   ============================================================ */
.m-elder {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 20rpx; padding: 22rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.mel-left { display: flex; flex-direction: column; gap: 4rpx; }
.mel-title { font-size: 28rpx; font-weight: 700; color: #1e293b; }
.mel-desc  { font-size: 22rpx; color: #94a3b8; }

/* ============================================================
   6. 编辑表单
   ============================================================ */
.m-edit-card {
  background: #fff; border-radius: 20rpx; padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  display: flex; flex-direction: column; gap: 18rpx;
}
.m-edit-field { display: flex; flex-direction: column; gap: 8rpx; }
.m-edit-label { font-size: 26rpx; font-weight: 600; color: #475569; }
.m-edit-field input {
  width: 100%; min-height: 76rpx; padding: 14rpx 18rpx;
  border-radius: 14rpx; background: #f8fafc;
  border: 1rpx solid #e2e8f0; box-sizing: border-box;
  font-size: 28rpx; color: #1e293b;
}
.m-edit-btn {
  height: 80rpx; line-height: 80rpx; border-radius: 14rpx;
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: #fff; font-size: 28rpx; font-weight: 700; border: none;
}
.m-edit-btn:active { opacity: 0.85; }
.m-sos-btn {
  height: 88rpx; line-height: 88rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #fff; font-size: 30rpx; font-weight: 700; border: none;
}
.m-sos-btn:active { opacity: 0.85; }

/* ============================================================
   7. 管理模式通用卡片
   ============================================================ */
.adm-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.adm-card-title {
  display: block; font-size: 28rpx; font-weight: 700; color: #1e293b;
  margin-bottom: 18rpx;
}
.adm-card-bottom { margin-bottom: 0; }

/* ---- 7a. 我的今日工作 ---- */
.adm-brief-grid {
  display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10rpx;
}
.adm-brief {
  position: relative; text-align: center;
  padding: 22rpx 8rpx; border-radius: 16rpx;
}
.adm-brief.yellow  { background: #fef9c3; }
.adm-brief.indigo { background: #eef2ff; }
.adm-brief.amber  { background: #fff7ed; }
.adm-brief.red    { background: #fef2f2; }
.adm-brief:active { opacity: 0.75; }
.adm-brief-num {
  display: block; font-size: 44rpx; font-weight: 800;
  line-height: 1.1; color: #1e293b;
}
.adm-brief.red .adm-brief-num   { color: #dc2626; }
.adm-brief.amber .adm-brief-num { color: #f59e0b; }
.adm-brief.indigo .adm-brief-num { color: #4338ca; }
.adm-brief.yellow .adm-brief-num { color: #b45309; }
.adm-brief-label {
  display: block; font-size: 20rpx; color: #64748b;
  margin-top: 6rpx; font-weight: 500;
}
.adm-brief-dot {
  position: absolute; top: 10rpx; right: 10rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 8rpx rgba(239,68,68,0.5);
}

/* ---- 7b. 积分与信誉 ---- */
.adm-credit-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 8rpx 8rpx;
}
.adm-credit-row:active { background: #f8fafc; border-radius: 14rpx; }
.acr-col {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  gap: 4rpx;
}
.acr-num {
  font-size: 48rpx; font-weight: 800; color: #1e293b;
  line-height: 1.1; font-variant-numeric: tabular-nums;
}
.acr-label { font-size: 22rpx; color: #94a3b8; }
.acr-arrow-wrap { flex-shrink: 0; }
.acr-arrow { font-size: 40rpx; color: #cbd5e1; }

/* ---- 7c. 管理工具箱 ---- */
.adm-toolbox {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx;
}
.atb-item {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding: 26rpx 8rpx; border-radius: 16rpx;
  background: #f8fafc; border: 1rpx solid #f1f5f9;
}
.atb-item:active { background: #eff6ff; border-color: #bfdbfe; }
.atb-icon { font-size: 40rpx; }
.atb-text { font-size: 26rpx; font-weight: 600; color: #334155; }

/* ---- 7d. 系统辅助 ---- */
.adm-sys-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 4rpx;
}
.adm-sys-row + .adm-sys-row { border-top: 1rpx solid #f1f5f9; }
.adm-sys-row:active { background: #f8fafc; margin: 0 -28rpx; padding-left: 32rpx; padding-right: 32rpx; border-radius: 0; }
.asr-left { display: flex; align-items: center; gap: 14rpx; flex: 1; }
.asr-icon { font-size: 30rpx; }
.asr-text { font-size: 28rpx; color: #334155; font-weight: 500; }
.asr-arrow { font-size: 34rpx; color: #cbd5e1; }
.asr-val { font-size: 24rpx; color: #94a3b8; }

/* ---- 7e. 底部账号元信息 ---- */
.adm-card-meta { margin-top: 6rpx; }
.adm-meta-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0;
}
.adm-meta-row + .adm-meta-row { border-top: 1rpx solid #f1f5f9; }
.amm-label { font-size: 24rpx; color: #94a3b8; }
.amm-value { font-size: 24rpx; color: #64748b; font-weight: 500; }
.amm-value.mono { font-family: monospace; font-size: 22rpx; }
.adm-card-meta-top { margin-top: 0; }
.adm-entry-card { border-radius: 20rpx; overflow: hidden; }
.adm-entry-card .adm-sys-row:active { background: #f8fafc; margin: 0; padding: 20rpx 28rpx; border-radius: 20rpx; }

/* ---- 修改个人信息弹窗 ---- */
.adm-edit-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 998;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
}
.adm-edit-popup {
  width: 620rpx; background: #fff; border-radius: 28rpx;
  padding: 48rpx 40rpx 44rpx; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.2);
}
.adm-edit-popup-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 40rpx;
}
.adm-edit-popup-title { font-size: 34rpx; font-weight: 700; color: #1e293b; }
.adm-edit-popup-close {
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  font-size: 36rpx; color: #94a3b8;
}
.adm-edit-popup-body {
  display: flex; flex-direction: column; gap: 36rpx; margin-bottom: 36rpx;
}
.adm-edit-popup-body .m-edit-label { font-size: 28rpx; font-weight: 600; color: #475569; }
.adm-edit-popup-body .m-edit-field input {
  width: 100%; min-height: 90rpx; padding: 18rpx 22rpx;
  border-radius: 14rpx; background: #f8fafc;
  border: 1rpx solid #e2e8f0; box-sizing: border-box;
  font-size: 30rpx; color: #1e293b; margin-top: 12rpx;
}
.adm-edit-popup-btn {
  width: 100%; height: 92rpx; line-height: 92rpx;
  border-radius: 16rpx; background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: #fff; font-size: 32rpx; font-weight: 700; border: none;
}
.adm-edit-popup-btn:active { opacity: 0.85; }

/* ============================================================
   8. 管理模式头部
   ============================================================ */
.profile-hero { position: relative; border-radius: 28rpx; overflow: hidden; background: linear-gradient(135deg, rgba(196,181,253,0.55) 0%, rgba(186,230,253,0.5) 20%, rgba(252,231,243,0.45) 45%, rgba(191,219,254,0.5) 70%, rgba(196,181,253,0.5) 100%); border: 1rpx solid rgba(255,255,255,0.35); box-shadow: 0 8rpx 32rpx rgba(139,92,246,0.08); }
.profile-hero-inner { position: relative; z-index: 1; padding: 40rpx 32rpx 36rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.profile-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,255,255,0.28); border: 2rpx solid rgba(255,255,255,0.45); display: flex; align-items: center; justify-content: center; }
.profile-avatar text { font-size: 42rpx; font-weight: 700; color: #1a1a2e; }
.profile-name { font-size: 36rpx; font-weight: 800; color: #1a1a2e; }
.profile-role { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: rgba(0,0,0,0.08); color: #1a1a2e; font-weight: 500; }

/* ============================================================
   8. 管理模式
   ============================================================ */
.mode-card { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 24rpx; border-radius: 20rpx; background: linear-gradient(135deg, #f5f3ff, #fff); border: 2rpx solid #ddd6fe; gap: 16rpx; }
.mode-card:active { background: #ede9fe; }
.mode-left { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.mode-title { font-size: 28rpx; font-weight: 700; color: #5b21b6; }
.mode-desc { font-size: 24rpx; color: #94a3b8; }
.mode-switch-pill { flex-shrink: 0; font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 999rpx; font-weight: 700; background: #e2e8f0; color: #64748b; }
.mode-switch-pill.on { background: #8b5cf6; color: #fff; }

/* 间距 */
.wrap { padding: 14rpx 22rpx 30rpx; display: flex; flex-direction: column; gap: 16rpx; }

/* ====================== 积分转盘弹窗 — 霓虹竞技·光芒四射 ====================== */
.lottery-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 999;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
}

.lottery-popup {
  width: 680rpx; height: 980rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 30rpx 36rpx;
  box-shadow: 0 20rpx 80rpx rgba(0,0,0,0.18), 0 0 60rpx rgba(230,57,70,0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.lottery-close {
  position: absolute; top: 16rpx; right: 20rpx;
  width: 48rpx; height: 48rpx; line-height: 48rpx;
  text-align: center; font-size: 36rpx; color: #94a3b8;
  font-weight: 300; z-index: 10;
}
.lottery-close:active { color: #e63946; }

.lottery-record {
  position: absolute; top: 20rpx; left: 24rpx;
  font-size: 24rpx; color: #e63946; font-weight: 600;
  padding: 6rpx 14rpx; border-radius: 8rpx;
  background: #fff5f5; z-index: 10;
}
.lottery-record:active { opacity: 0.7; }

.lottery-record-back {
  display: block; width: 100%;
  font-size: 26rpx; color: #e63946; font-weight: 600;
  padding: 6rpx 0 20rpx;
}

/* 抽奖记录面板 */
.lottery-history-panel {
  width: 100%; flex: 1; min-height: 0;
}
.lhp-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}
.lhp-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.lhp-close {
  width: 48rpx; height: 48rpx; line-height: 48rpx;
  text-align: center; font-size: 32rpx; color: #94a3b8;
}
.lhp-empty {
  display: flex; justify-content: center; padding: 80rpx 0;
  font-size: 26rpx; color: #94a3b8;
}
.lhp-list { display: flex; flex-direction: column; gap: 12rpx; }
.lhp-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 16rpx; border-radius: 14rpx;
  background: #f8fafc;
}
.lhpr-left { display: flex; flex-direction: column; gap: 4rpx; flex: 1; overflow: hidden; }
.lhpr-name { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.lhpr-time { font-size: 22rpx; color: #94a3b8; }
.lhpr-right { flex-shrink: 0; }
.lhpr-win { font-size: 24rpx; font-weight: 700; color: #10b981; }
.lhpr-lose { font-size: 24rpx; color: #94a3b8; }

.lottery-title {
  font-size: 36rpx; font-weight: 800; color: #1e293b;
  margin-bottom: 24rpx; position: relative; z-index: 2;
}

/* 转盘外层光晕 */
.lottery-wheel-wrap {
  position: relative; z-index: 2;
}
.lottery-wheel-glow {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx; height: 600rpx; border-radius: 50%;
  background: transparent;
  box-shadow:
    0 0 30rpx rgba(230,57,70,0.25),
    0 0 60rpx rgba(230,57,70,0.15),
    0 0 90rpx rgba(255,215,0,0.1),
    0 0 140rpx rgba(230,57,70,0.06);
  pointer-events: none; z-index: -1;
}

.lw-btn {
  margin-top: 28rpx; width: 380rpx; height: 88rpx; line-height: 88rpx;
  background: linear-gradient(180deg, #ff6b4a 0%, #e63946 30%, #c0392b 100%);
  border-radius: 44rpx; color: #ffffff; font-size: 34rpx;
  font-weight: 800; text-align: center; position: relative; z-index: 2;
  box-shadow:
    0 0 30rpx rgba(230,57,70,0.5),
    0 0 60rpx rgba(255,215,0,0.25),
    0 8rpx 24rpx rgba(192,57,43,0.4),
    inset 0 1rpx 0 rgba(255,255,255,0.2);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}
.lw-btn:active { opacity: 0.85; transform: scale(0.97); }
.lw-btn.disabled { filter: grayscale(0.5) brightness(0.85); pointer-events: none; }

.lottery-result {
  margin-top: 20rpx; min-height: 64rpx; font-size: 32rpx;
  font-weight: 700; text-align: center; opacity: 0; transition: all 0.4s;
  position: relative; z-index: 2; color: #1e293b;
}
.lottery-result.show { opacity: 1; }
.lottery-score { color: #e63946; font-size: 38rpx; font-weight: 800; }
.lottery-no-win { color: #94a3b8; }

.lottery-footer {
  width: 100%; display: flex; justify-content: center;
  margin-top: 32rpx; font-size: 24rpx; color: #94a3b8;
  position: relative; z-index: 2;
}
