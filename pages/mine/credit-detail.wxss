.page { background: linear-gradient(180deg, #f0f2f8 0%, #f7f8fc 100%); }
.wrap { padding: 18rpx 24rpx 30rpx; display: flex; flex-direction: column; gap: 18rpx; }

/* Tabs */
.cd-tabs {
  display: flex; background: #fff; border-radius: 20rpx;
  padding: 8rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.cd-tab {
  flex: 1; text-align: center; font-size: 28rpx; font-weight: 600;
  color: #94a3b8; padding: 16rpx 0; border-radius: 16rpx;
}
.cd-tab.on { background: #6366f1; color: #fff; }

/* 流水列表 */
.cd-list { display: flex; flex-direction: column; gap: 6rpx; }
.cd-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 22rpx; background: #fff; border-radius: 16rpx;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.02); gap: 16rpx;
}
.cdi-left { flex: 1; display: flex; align-items: center; gap: 16rpx; overflow: hidden; }
.cdi-dot {
  width: 40rpx; height: 40rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #fff;
}
.cdi-dot.earn  { background: #10b981; }
.cdi-dot.spend { background: #ef4444; }
.cdi-info { flex: 1; overflow: hidden; display: flex; flex-direction: column; gap: 4rpx; }
.cdi-source { font-size: 28rpx; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cdi-time { font-size: 22rpx; color: #94a3b8; }
.cdi-amount { font-size: 30rpx; font-weight: 800; flex-shrink: 0; }
.cdi-amount.earn  { color: #10b981; }
.cdi-amount.spend { color: #ef4444; }
.cdi-right { flex-shrink: 0; text-align: right; }
.cdi-change { display: block; font-size: 30rpx; font-weight: 800; }
.cdi-change.earn  { color: #10b981; }
.cdi-change.spend { color: #ef4444; }
.cdi-balance { display: block; font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }

/* 空态 */
.cd-empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; gap: 12rpx; }
.cd-empty-icon { font-size: 64rpx; }
.cd-empty-text { font-size: 28rpx; color: #94a3b8; }
