<navigation-bar title="我的" back="{{false}}" color="#fff" background="transparent"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">

    <!-- ===== 普通用户模式 ===== -->
    <block wx:if="{{!adminMode}}">

      <!-- 1. 渐变弥散光头部 -->
      <view class="m-header" style="padding-top: {{navBarHeight}}px;">
        <view class="mh-orb mh-orb-1"></view>
        <view class="mh-orb mh-orb-2"></view>
        <view class="mh-orb mh-orb-3"></view>
        <view class="mh-orb mh-orb-4"></view>
        <view class="mh-orb mh-orb-5"></view>
        <view class="mh-orb mh-orb-6"></view>
        <view class="mh-orb mh-orb-7"></view>
        <view class="mh-orb mh-orb-8"></view>
        <view class="mh-dot mh-dot-1"></view>
        <view class="mh-dot mh-dot-2"></view>
        <view class="mh-dot mh-dot-3"></view>
        <view class="mh-dot mh-dot-4"></view>
        <view class="mh-dot mh-dot-5"></view>
        <view class="mh-dot mh-dot-6"></view>
        <view class="mh-dot mh-dot-7"></view>
        <view class="mh-dot mh-dot-8"></view>
        <view class="mh-dot mh-dot-9"></view>
        <view class="mh-dot mh-dot-10"></view>
        <view class="mh-dot mh-dot-11"></view>
        <view class="mh-dot mh-dot-12"></view>
        <view class="mh-avatar">👤</view>
        <text class="mh-name">{{user.nickname || '登录/注册'}}</text>
        <text class="mh-tag">幸福社区 · 认证业主</text>
        <view class="mh-stats">
          <view class="mhs-col">
            <text class="mhs-num">{{user.totalPoints || 0}}</text>
            <text class="mhs-label">积分</text>
          </view>
          <view class="mhs-col">
            <text class="mhs-num">0</text>
            <text class="mhs-label">卡券</text>
          </view>
          <view class="mhs-col">
            <text class="mhs-num">{{user.creditScore || 100}}</text>
            <text class="mhs-label">信誉分</text>
          </view>
        </view>
      </view>

      <!-- 2. 快速入口 -->
      <view class="m-grid">
        <view class="mg-item" bindtap="goCoupon">
          <view class="mgi-badge bg-amber">🎫</view>
          <text class="mgi-text">领券中心</text>
        </view>
        <view class="mg-item" bindtap="openLottery">
          <view class="mgi-badge bg-rose">🎡</view>
          <text class="mgi-text">积分转盘</text>
        </view>
        <view class="mg-item" bindtap="goGift">
          <view class="mgi-badge bg-mint">🎁</view>
          <text class="mgi-text">爱心商城</text>
        </view>
      </view>

      <!-- 3. 模式切换 -->
      <view class="m-mode-card" wx:if="{{isStaff}}" bindtap="toggleAdminMode">
        <view class="mm-left">
          <text class="mm-icon">🔧</text>
          <text class="mm-text">切换到管理模式</text>
        </view>
        <text class="mm-arrow">›</text>
      </view>

      <!-- 4. 功能菜单 -->
      <view class="m-menu">
        <view class="mm-item" bindtap="toggleEdit">
          <view class="mmi-icon bg-red">✏️</view>
          <text class="mmi-text">个人信息</text>
          <text class="mmi-arrow">›</text>
        </view>
        <view class="mm-item" bindtap="goHouses">
          <view class="mmi-icon bg-blue">🏠</view>
          <text class="mmi-text">我的房屋</text>
          <text class="mmi-arrow">›</text>
        </view>
        <view class="mm-item" bindtap="goRedemptions">
          <view class="mmi-icon bg-purple">📦</view>
          <text class="mmi-text">兑换记录</text>
          <text class="mmi-arrow">›</text>
        </view>
        <view class="mm-item">
          <view class="mmi-icon bg-green">⚙️</view>
          <text class="mmi-text">系统设置</text>
          <text class="mmi-arrow">›</text>
        </view>
      </view>

      <!-- 5. 老人模式 -->
      <view class="m-elder">
        <view class="mel-left">
          <text class="mel-title">👴 老人模式</text>
          <text class="mel-desc">首页展示一键求助悬浮按钮</text>
        </view>
        <switch checked="{{form.elderMode}}" bindchange="onElder" color="#6366f1" />
      </view>

      <!-- 6. 编辑表单 -->
      <view class="m-edit-card" wx:if="{{showEdit}}">
        <view class="m-edit-field">
          <text class="m-edit-label">昵称</text>
          <input placeholder="设置你的社区昵称" value="{{form.nickname}}" bindinput="onNick" />
        </view>
        <view class="m-edit-field">
          <text class="m-edit-label">手机号</text>
          <input placeholder="选填，方便求助时联系" value="{{form.phone}}" bindinput="onPhone" />
        </view>
        <button class="m-edit-btn" loading="{{saving}}" bindtap="save">保存修改</button>
        <button class="m-sos-btn" wx:if="{{form.elderMode}}" bindtap="sos">🆘 紧急求助</button>
      </view>

    </block>

    <!-- ===== 管理模式 ===== -->
    <block wx:if="{{adminMode}}">
      <!-- 用户头部 -->
      <view class="profile-hero">
        <view class="profile-hero-inner">
          <view class="profile-avatar"><text>👤</text></view>
          <text class="profile-name">{{user.nickname || '未设置昵称'}}</text>
          <view class="profile-role {{user.role}}">{{roleText}}</view>
        </view>
      </view>

      <!-- 模式切换 -->
      <view class="mode-card" bindtap="toggleAdminMode">
        <view class="mode-left">
          <text class="mode-title">🔧 当前：管理模式</text>
          <text class="mode-desc">点击返回普通用户视图</text>
        </view>
        <view class="mode-switch-pill on">管理中</view>
      </view>

      <!-- ==== 1. 账号信息 ==== -->
      <view class="adm-card adm-card-meta-top">
        <view class="adm-meta-row">
          <text class="amm-label">账号标识</text>
          <text class="amm-value mono">{{maskedOpenid}}</text>
        </view>
        <view class="adm-meta-row">
          <text class="amm-label">角色权限</text>
          <text class="maic-badge {{user.role}}">{{roleText}}</text>
        </view>
      </view>

      <!-- ==== 2. 修改个人信息（可点击入口） ==== -->
      <view class="adm-card adm-entry-card" bindtap="openEdit">
        <view class="adm-sys-row">
          <view class="asr-left">
            <text class="asr-icon">✏️</text>
            <text class="asr-text">修改个人信息</text>
          </view>
          <text class="asr-arrow">›</text>
        </view>
      </view>

      <!-- ==== 3. 我的今日工作 ==== -->
      <view class="adm-card">
        <text class="adm-card-title">📋 我的今日工作</text>
        <view class="adm-brief-grid">
          <view class="adm-brief yellow" bindtap="go" data-url="/pages/admin/todo">
            <text class="adm-brief-num">{{briefRepairs || 0}}</text>
            <text class="adm-brief-label">待处理报修</text>
          </view>
          <view class="adm-brief indigo" bindtap="go" data-url="/pages/admin/house-verify">
            <text class="adm-brief-num">{{briefHouses || 0}}</text>
            <text class="adm-brief-label">待核验房屋</text>
          </view>
          <view class="adm-brief amber" bindtap="go" data-url="/pages/admin/todo">
            <text class="adm-brief-num">{{briefHelps || 0}}</text>
            <text class="adm-brief-label">待接单互助</text>
          </view>
          <view class="adm-brief red">
            <text class="adm-brief-num">{{briefSos || 0}}</text>
            <text class="adm-brief-label">未处理 SOS</text>
            <view wx:if="{{briefSos > 0}}" class="adm-brief-dot"></view>
          </view>
        </view>
      </view>

      <!-- ==== 4. 积分与信誉 ==== -->
      <view class="adm-card">
        <text class="adm-card-title">💎 积分与信誉</text>
        <view class="adm-credit-row" bindtap="go" data-url="/pages/mine/credit-detail">
          <view class="acr-col">
            <text class="acr-num">{{user.totalPoints || 0}}</text>
            <text class="acr-label">总积分</text>
          </view>
          <view class="acr-col">
            <text class="acr-num">{{user.creditScore || 100}}</text>
            <text class="acr-label">信誉分</text>
          </view>
          <view class="acr-arrow-wrap">
            <text class="acr-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- ==== 5. 管理工具箱 ==== -->
      <view class="adm-card">
        <text class="adm-card-title">🧰 管理工具箱</text>
        <view class="adm-toolbox">
          <view class="atb-item" bindtap="go" data-url="/pages/admin/notice-manage">
            <text class="atb-icon">📢</text>
            <text class="atb-text">公告管理</text>
          </view>
          <view class="atb-item" bindtap="go" data-url="/pages/admin/house-manage">
            <text class="atb-icon">🏠</text>
            <text class="atb-text">房屋录入</text>
          </view>
          <view wx:if="{{user.role === 'admin'}}" class="atb-item" bindtap="go" data-url="/pages/admin/user-manage">
            <text class="atb-icon">👥</text>
            <text class="atb-text">用户管理</text>
          </view>
          <view class="atb-item" bindtap="go" data-url="/pages/admin/dashboard">
            <text class="atb-icon">📥</text>
            <text class="atb-text">数据导出</text>
          </view>
        </view>
      </view>

      <!-- ==== 4. 系统辅助 ==== -->
      <view class="adm-card adm-card-bottom">
        <text class="adm-card-title">⚙️ 系统辅助</text>
        <view class="adm-sys-row" bindtap="clearCache">
          <view class="asr-left">
            <text class="asr-icon">🗑️</text>
            <text class="asr-text">清除缓存</text>
          </view>
          <text class="asr-arrow">›</text>
        </view>
        <view class="adm-sys-row">
          <view class="asr-left">
            <text class="asr-icon">ℹ️</text>
            <text class="asr-text">关于邻智灵</text>
          </view>
          <text class="asr-val">v1.0.2</text>
        </view>
      </view>

      <!-- 管理员账号信息（轻量） -->
      </block>

  </view>   <!-- wrap -->
</scroll-view>

<!-- ===== 修改个人信息弹窗 ===== -->
<view class="adm-edit-mask" wx:if="{{showEditPopup}}" catchtap="closeEdit">
  <view class="adm-edit-popup" catchtap="nop">
    <view class="adm-edit-popup-head">
      <text class="adm-edit-popup-title">修改个人信息</text>
      <view class="adm-edit-popup-close" bindtap="closeEdit">✕</view>
    </view>
    <view class="adm-edit-popup-body">
      <view class="m-edit-field">
        <text class="m-edit-label">昵称</text>
        <input placeholder="设置你的社区昵称" value="{{form.nickname}}" bindinput="onNick" />
      </view>
      <view class="m-edit-field">
        <text class="m-edit-label">手机号</text>
        <input placeholder="选填，方便求助时联系" value="{{form.phone}}" bindinput="onPhone" />
      </view>
    </view>
    <button class="adm-edit-popup-btn" loading="{{saving}}" bindtap="save">保存修改</button>
  </view>
</view>

<!-- ===== 积分转盘弹窗（lucky-canvas） ===== -->
<view class="lottery-mask" wx:if="{{lotteryShow}}" bindtap="closeLottery">
  <view class="lottery-popup" catchtap="nop">

    <view class="lottery-close" bindtap="closeLottery">✕</view>

    <!-- 抽奖记录面板 -->
    <block wx:if="{{lotteryHistoryShow}}">
      <text class="lottery-record-back" bindtap="closeLotteryHistory">‹ 返回转盘</text>
      <scroll-view scroll-y="true" class="lottery-history-panel" catchtap="nop">
        <view class="lhp-head">
          <text class="lhp-title">📋 抽奖记录</text>
          <text class="lhp-close" bindtap="closeLotteryHistory">✕</text>
        </view>
        <view wx:if="{{!lotteryHistory.length}}" class="lhp-empty">
          <text>暂无抽奖记录</text>
        </view>
        <view wx:else class="lhp-list">
          <view wx:for="{{lotteryHistory}}" wx:key="_id" class="lhp-row">
            <view class="lhpr-left">
              <text class="lhpr-name">{{item.prizeName}}</text>
              <text class="lhpr-time">{{item.timeText}}</text>
            </view>
            <view class="lhpr-right">
              <text wx:if="{{item.isWin}}" class="lhpr-win">🎉 中奖</text>
              <text wx:else class="lhpr-lose">未中</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- 转盘主体（记录面板打开时隐藏，避免 canvas 遮挡） -->
    <block wx:else>
      <text class="lottery-record" bindtap="openLotteryHistory">抽奖记录</text>

      <text class="lottery-title">🎉 积分幸运转盘</text>

      <view class="lottery-wheel-wrap">
        <view class="lottery-wheel-glow"></view>
        <lucky-wheel
          id="myLucky"
          width="580rpx"
          height="580rpx"
          blocks="{{blocks}}"
          prizes="{{prizes}}"
          buttons="{{buttons}}"
          defaultStyle="{{defaultStyle}}"
          bindend="onEnd"
        />
      </view>

      <view class="lw-btn {{lotterySpinning ? 'disabled' : ''}}" bindtap="doLottery">
        <text>{{lotterySpinning ? '抽奖中...' : '🎯 开始抽奖'}}</text>
      </view>

      <view class="lottery-result {{lotteryResult ? 'show' : ''}}">
        <block wx:if="{{lotteryResult}}">
          <text wx:if="{{lotteryResult !== '谢谢惠顾'}}">🎉 恭喜获得 <text class="lottery-score">{{lotteryResult}}</text></text>
          <text wx:else class="lottery-no-win">😅 {{lotteryResult}}，下次一定！</text>
        </block>
      </view>

      <view class="lottery-footer">
        <text class="lottery-remain">测试模式 · 不扣积分</text>
      </view>
    </block>
  </view>
</view>
</view>
