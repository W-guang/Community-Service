<navigation-bar title="我的" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
  <view class="wrap">
    <!-- ========== 用户信息卡片 ========== -->
    <view class="card">
      <view class="row">
        <view class="section-title">{{user.nickname || '未设置昵称'}}</view>
        <view class="tag">{{roleText}}</view>
      </view>
      <view class="muted mt">OpenID：{{user.openid}}</view>
      <view class="row mt">
        <button class="btn" size="mini" bindtap="wxLogin">微信授权更新昵称头像</button>
        <button class="btn" size="mini" bindtap="goHouses">我的房屋</button>
      </view>
    </view>

    <!-- ========== 管理员模式切换开关（仅staff/admin可见） ========== -->
    <view class="card admin-switch-card" wx:if="{{isStaff}}" bindtap="toggleAdminMode">
      <view class="row">
        <view class="column">
          <view class="section-title">{{adminMode ? '管理模式' : '普通模式'}}</view>
          <view class="muted">{{adminMode ? '点击切换回普通用户视图' : '点击切换到管理模式'}}</view>
        </view>
        <view class="mode-indicator {{adminMode ? 'on' : 'off'}}">
          {{adminMode ? '🔧' : '🏠'}}
        </view>
      </view>
    </view>

    <!-- ========== 管理员模式：数据看板 ========== -->
    <block wx:if="{{adminMode && stats}}">
      <view class="card">
        <view class="section-title">📊 数据概览</view>
        <view class="stats-grid">
          <view class="stat-item">
            <view class="stat-num">{{stats.repairs.total || 0}}</view>
            <view class="stat-label">报修总数</view>
          </view>
          <view class="stat-item warn">
            <view class="stat-num">{{stats.repairs.pending || 0}}</view>
            <view class="stat-label">待受理</view>
          </view>
          <view class="stat-item">
            <view class="stat-num">{{stats.helps.total || 0}}</view>
            <view class="stat-label">互助总数</view>
          </view>
          <view class="stat-item warn">
            <view class="stat-num">{{stats.helps.open || 0}}</view>
            <view class="stat-label">待接单</view>
          </view>
          <view class="stat-item danger">
            <view class="stat-num">{{stats.sos.pending || 0}}</view>
            <view class="stat-label">紧急求助</view>
          </view>
          <view class="stat-item">
            <view class="stat-num">{{stats.notices.total || 0}}</view>
            <view class="stat-label">公告总数</view>
          </view>
        </view>
      </view>

      <!-- 管理功能入口 -->
      <view class="card">
        <view class="section-title">管理功能</view>
        <view class="admin-menu">
          <view class="admin-menu-item" bindtap="go" data-url="/pages/admin/todo">
            <view class="menu-icon">📋</view>
            <view class="menu-info">
              <view class="menu-name">待办处理</view>
              <view class="menu-desc">报修工单与SOS求助</view>
            </view>
            <view class="arrow">></view>
          </view>
          <view class="admin-menu-item" bindtap="go" data-url="/pages/admin/notice-manage">
            <view class="menu-icon">📢</view>
            <view class="menu-info">
              <view class="menu-name">公告管理</view>
              <view class="menu-desc">发布与编辑社区公告</view>
            </view>
            <view class="arrow">></view>
          </view>
          <view class="admin-menu-item" wx:if="{{user.role==='admin'}}" bindtap="go" data-url="/pages/admin/user-manage">
            <view class="menu-icon">👥</view>
            <view class="menu-info">
              <view class="menu-name">用户管理</view>
              <view class="menu-desc">角色分配与白名单管理</view>
            </view>
            <view class="arrow">></view>
          </view>
          <view class="admin-menu-item" bindtap="go" data-url="/pages/admin/house-verify">
            <view class="menu-icon">🏠</view>
            <view class="menu-info">
              <view class="menu-name">房屋核验</view>
              <view class="menu-desc">审核绑定申请</view>
            </view>
            <view class="arrow">></view>
          </view>
          <view class="admin-menu-item" bindtap="go" data-url="/pages/admin/dashboard">
            <view class="menu-icon">📈</view>
            <view class="menu-info">
              <view class="menu-name">数据看板</view>
              <view class="menu-desc">详细统计与报表导出</view>
            </view>
            <view class="arrow">></view>
          </view>
        </view>
      </view>
    </block>

    <!-- ========== 普通用户模式：个人信息 ========== -->
    <block wx:if="{{!adminMode}}">
      <view class="card form">
        <view class="field">
          <view class="label">昵称</view>
          <input placeholder="用于显示在沟通记录里" value="{{form.nickname}}" bindinput="onNick" />
        </view>
        <view class="field">
          <view class="label">手机号</view>
          <input placeholder="求助时可用（可选）" value="{{form.phone}}" bindinput="onPhone" />
        </view>
        <view class="row">
          <view class="label">老人模式</view>
          <switch checked="{{form.elderMode}}" bindchange="onElder" />
        </view>
        <button class="btn-primary submit" loading="{{saving}}" bindtap="save">保存</button>
      </view>

      <!-- 管理入口（普通模式下的快捷入口） -->
      <view class="card" wx:if="{{isStaff}}">
        <view class="section-title">管理入口</view>
        <view class="menu">
          <view class="menu-item" bindtap="go" data-url="/pages/admin/todo">待办处理（报修/求助）</view>
          <view class="menu-item" bindtap="go" data-url="/pages/admin/notice-manage">公告发布/管理</view>
          <view class="menu-item" wx:if="{{user.role==='admin'}}" bindtap="go" data-url="/pages/admin/user-manage">用户/网格员管理</view>
          <view class="menu-item" bindtap="go" data-url="/pages/admin/house-verify">房屋核验</view>
          <view class="menu-item" bindtap="go" data-url="/pages/admin/dashboard">数据看板（简版）</view>
        </view>
      </view>

      <!-- 老人模式SOS -->
      <view class="card" wx:if="{{form.elderMode}}">
        <view class="section-title">老人模式 · 一键求助</view>
        <button class="btn-danger sos" bindtap="sos">紧急求助</button>
      </view>
    </block>
  </view>
</view>
