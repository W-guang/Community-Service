/* ============================================================
   领券中心
   ============================================================ */
.page { background: linear-gradient(180deg, #fef3c7 0%, #f7f9fa 15%, #f7f9fa 100%); }

/* ---- 顶部横幅 ---- */
.c-banner { width: 100%; height: 260rpx; position: relative; overflow: hidden; }
.c-banner-img { width: 100%; height: 100%; display: block; }
.c-banner-mask {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(245,158,11,0.6), rgba(217,119,6,0.35));
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 8rpx;
}
.c-banner-title { font-size: 40rpx; font-weight: 800; color: #fff; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.c-banner-sub  { font-size: 24rpx; color: rgba(255,255,255,0.85); }

/* ---- 分类标签栏 ---- */
.c-cat-scroll { padding: 14rpx 24rpx 8rpx; }
.c-cat-row { white-space: nowrap; width: 100%; }
.c-cat-item {
  display: inline-block; padding: 12rpx 28rpx; margin-right: 14rpx;
  border-radius: 999rpx; font-size: 26rpx; color: #64748b;
  background: #fff; font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.c-cat-item.on {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff; font-weight: 700;
}

/* ---- 积分条 ---- */
.c-points-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin: 10rpx 24rpx; padding: 20rpx 24rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.cpb-label { font-size: 26rpx; color: #64748b; font-weight: 500; }
.cpb-num { font-size: 32rpx; color: #f59e0b; font-weight: 800; }

/* ---- 网格 ---- */
.wrap { padding: 8rpx 24rpx 30rpx; }
.c-empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; gap: 12rpx; }
.c-empty-icon { font-size: 72rpx; }
.c-empty-text { font-size: 28rpx; color: #94a3b8; }

.c-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }

/* ============================================================
   优惠券卡片
   ============================================================ */
.c-card {
  width: calc(50% - 8rpx);
  background: #fff; border-radius: 18rpx; overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,0.04);
  position: relative;
}
.c-card:active { opacity: 0.9; }

/* ---- 券面金额区（彩色背景） ---- */
.cc-left {
  width: 100%; padding: 28rpx 0 14rpx;
  display: flex; flex-direction: column; align-items: center;
  border-bottom: 2rpx dashed rgba(255,255,255,0.35);
}
.ccl-value { font-size: 56rpx; font-weight: 900; color: #fff; line-height: 1; }
.ccl-unit  { font-size: 22rpx; color: rgba(255,255,255,0.85); margin-top: 2rpx; }
.ccl-label { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 12rpx; }

/* ---- 券面信息区 ---- */
.cc-right {
  padding: 16rpx 16rpx 0;
  display: flex; flex-direction: column; gap: 4rpx;
}
.ccr-name {
  font-size: 26rpx; font-weight: 600; color: #1e293b;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  line-height: 1.3;
}
.ccr-expire { font-size: 20rpx; color: #94a3b8; }
.ccr-points { font-size: 22rpx; color: #f59e0b; font-weight: 700; }

/* ---- 兑换按钮 ---- */
.ccr-btn {
  margin: 12rpx 16rpx 16rpx; padding: 12rpx 0; border-radius: 10rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff; font-size: 24rpx; font-weight: 700; text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(245,158,11,0.2);
}
.ccr-btn:active { opacity: 0.8; transform: scale(0.97); }
.ccr-btn.claimed {
  background: #e2e8f0; color: #94a3b8;
  box-shadow: none; pointer-events: none;
}

/* ---- 已领取角标 ---- */
.cc-claimed-tag {
  position: absolute; top: 0; right: 0;
  font-size: 18rpx; font-weight: 600; color: #fff;
  background: #10b981; padding: 4rpx 12rpx;
  border-radius: 0 18rpx 0 12rpx;
}
