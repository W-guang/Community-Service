/* ============================================================
   区块
   ============================================================ */
.section-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-top: 6rpx solid #10b981;
}
.sec-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12rpx; margin-bottom: 12rpx;
}
.sec-head-left { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.sec-icon {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  background: #ecfdf5; display: flex; align-items: center;
  justify-content: center; font-size: 28rpx; flex-shrink: 0;
}
.sec-head-text { display: flex; flex-direction: column; gap: 2rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.sec-sub  { font-size: 22rpx; color: #94a3b8; }
.btn-add {
  flex-shrink: 0; font-size: 26rpx; padding: 14rpx 24rpx;
  border-radius: 14rpx; background: linear-gradient(135deg, #10b981, #059669);
  color: #fff; font-weight: 600; border: none;
}

/* ============================================================
   房屋项 & 空状态
   ============================================================ */
.house-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 18rpx; border-radius: 14rpx;
  background: #fafcfd; border: 1rpx solid #f1f5f9; gap: 16rpx;
  margin-top: 10rpx;
}
.hi-left { flex: 1; overflow: hidden; display: flex; flex-direction: column; gap: 4rpx; }
.hi-addr { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.hi-name { font-size: 24rpx; color: #94a3b8; }
.hi-status {
  flex-shrink: 0; font-size: 22rpx; padding: 6rpx 16rpx;
  border-radius: 999rpx; font-weight: 700;
}
.hi-status.bound          { background: #d1fae5; color: #065f46; }
.hi-status.pending_verify { background: #fef3c7; color: #92400e; }
.hi-status.rejected       { background: #fee2e2; color: #dc2626; }

.empty-note {
  display: flex; flex-direction: column; align-items: center;
  padding: 50rpx 0 24rpx; gap: 10rpx;
}
.empty-note-icon { font-size: 60rpx; }
.empty-note-text { font-size: 26rpx; color: #94a3b8; }

.wrap { padding: 18rpx 24rpx; }
