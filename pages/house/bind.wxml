<navigation-bar title="房屋绑定" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">

    <view class="tip-card">
      <text class="tip-icon">🏠</text>
      <view class="tip-text">
        <text class="tip-title">绑定房屋</text>
        <text class="tip-desc">绑定房屋后即可使用报修、公告、互助等核心功能。支持绑定多套房屋，同一房屋也可被多个家人绑定。</text>
      </view>
    </view>

    <view class="section-card">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon"><text>📝</text></view>
          <text class="sec-title">房屋信息</text>
        </view>
      </view>

      <view class="form">
        <view class="form-row">
          <view class="field flex-1">
            <text class="label">小区名称</text>
            <input placeholder="例如：学府小区" value="{{form.community}}" bindinput="onInput" data-k="community" />
          </view>
          <view class="field flex-1">
            <text class="label">楼栋</text>
            <input placeholder="例如：3号楼" value="{{form.building}}" bindinput="onInput" data-k="building" />
          </view>
        </view>
        <view class="form-row">
          <view class="field flex-1">
            <text class="label">单元</text>
            <input placeholder="例如：2单元" value="{{form.unit}}" bindinput="onInput" data-k="unit" />
          </view>
          <view class="field flex-1">
            <text class="label">房号</text>
            <input placeholder="例如：1202" value="{{form.room}}" bindinput="onInput" data-k="room" />
          </view>
        </view>
        <view class="form-row">
          <view class="field flex-1">
            <text class="label">业主姓名</text>
            <input placeholder="用于线下核验身份" value="{{form.name}}" bindinput="onInput" data-k="name" />
          </view>
          <view class="field flex-1">
            <text class="label">手机号（可选）</text>
            <input placeholder="便于物业联系" value="{{form.phone}}" bindinput="onInput" data-k="phone" />
          </view>
        </view>

        <view class="btn-row">
          <button class="btn-submit" loading="{{submitting}}" bindtap="submit">提交绑定申请</button>
          <button class="btn-outline" bindtap="goMyHouses">查看我的房屋</button>
        </view>
      </view>
    </view>

    <view class="section-card bindings-card" wx:if="{{bindings && bindings.houses && bindings.houses.length}}">
      <view class="sec-head">
        <text class="sec-title">📋 我的绑定记录</text>
        <button size="mini" class="btn-refresh" bindtap="refresh">刷新</button>
      </view>
      <view wx:for="{{bindings.houses}}" wx:key="_id" class="bind-item">
        <view class="bind-info">
          <text class="bind-addr">{{item.community}} {{item.building}} {{item.unit}} {{item.room}}</text>
          <text class="bind-name">{{item.name}}<text wx:if="{{item.phone}}"> · {{item.phone}}</text></text>
        </view>
        <view class="bind-status {{item.status}}">{{statusText(item.status)}}</view>
      </view>
    </view>

  </view>
</scroll-view>
</view>
