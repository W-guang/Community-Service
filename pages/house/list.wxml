<navigation-bar title="我的房屋" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="page">
<scroll-view scroll-y="true" class="scroll-content">
  <view class="wrap">

    <view class="section-card">
      <view class="sec-head">
        <view class="sec-head-left">
          <view class="sec-icon"><text>🏠</text></view>
          <view class="sec-head-text">
            <text class="sec-title">已绑定房屋</text>
            <text class="sec-sub">共 {{boundCount}} 套</text>
          </view>
        </view>
        <button class="btn-add" bindtap="goBind">继续绑定</button>
      </view>

      <view class="empty-note" wx:if="{{!items.length}}">
        <text class="empty-note-icon">🏡</text>
        <text class="empty-note-text">暂无绑定记录，去绑定你的房屋吧</text>
      </view>

      <view wx:for="{{items}}" wx:key="_id" class="house-item">
        <view class="hi-left">
          <text class="hi-addr">{{item.community}} {{item.building}} {{item.unit}} {{item.room}}</text>
          <text class="hi-name">{{item.name}}<text wx:if="{{item.phone}}"> · {{item.phone}}</text></text>
        </view>
        <view class="hi-status {{item.status}}">{{statusText(item.status)}}</view>
      </view>
    </view>

  </view>
</scroll-view>
</view>
