/* ============================================================
   提示卡片
   ============================================================ */
.tip-card {
  display: flex; align-items: flex-start; gap: 18rpx;
  padding: 24rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #eff6ff, #fff);
  border: 2rpx solid #bfdbfe;
}
.tip-icon { font-size: 48rpx; flex-shrink: 0; }
.tip-text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.tip-title { font-size: 30rpx; font-weight: 700; color: #1e40af; }
.tip-desc { font-size: 26rpx; color: #64748b; line-height: 1.5; }

/* ============================================================
   表单卡片
   ============================================================ */
.section-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border-top: 6rpx solid #3b82f6;
}
.bindings-card { border-top: 6rpx solid #10b981; }
.sec-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12rpx; margin-bottom: 18rpx;
}
.sec-head-left { flex: 1; display: flex; align-items: center; gap: 14rpx; }
.sec-icon {
  width: 56rpx; height: 56rpx; border-radius: 16rpx;
  background: #eff6ff; display: flex; align-items: center;
  justify-content: center; font-size: 28rpx; flex-shrink: 0;
}
.sec-title { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.btn-refresh {
  font-size: 24rpx; padding: 8rpx 18rpx; border-radius: 10rpx;
  background: #f8fafc; color: #64748b; border: 1rpx solid #e2e8f0;
}

/* 表单 */
.form { display: flex; flex-direction: column; gap: 18rpx; }
.form-row { display: flex; gap: 16rpx; }
.field { display: flex; flex-direction: column; gap: 8rpx; }
.flex-1 { flex: 1; }
.label { font-size: 26rpx; font-weight: 600; color: #475569; }

/* 按钮 */
.btn-row { display: flex; gap: 14rpx; }
.btn-submit {
  flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff; font-size: 28rpx; font-weight: 700; border: none;
  box-shadow: 0 6rpx 20rpx rgba(59,130,246,0.2);
}
.btn-submit:active { opacity: 0.85; }
.btn-outline {
  flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 16rpx;
  background: #fff; color: #3b82f6; font-size: 28rpx; font-weight: 600;
  border: 2rpx solid #bfdbfe;
}
.btn-outline:active { background: #eff6ff; }

/* ============================================================
   绑定记录
   ============================================================ */
.bind-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 18rpx; border-radius: 14rpx;
  background: #fafcfd; border: 1rpx solid #f1f5f9; gap: 16rpx;
  margin-top: 10rpx;
}
.bind-info { flex: 1; overflow: hidden; display: flex; flex-direction: column; gap: 4rpx; }
.bind-addr { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.bind-name { font-size: 24rpx; color: #94a3b8; }
.bind-status {
  flex-shrink: 0; font-size: 22rpx; padding: 6rpx 16rpx;
  border-radius: 999rpx; font-weight: 700;
}
.bind-status.bound          { background: #d1fae5; color: #065f46; }
.bind-status.pending_verify { background: #fef3c7; color: #92400e; }
.bind-status.rejected       { background: #fee2e2; color: #dc2626; }

.wrap { padding: 18rpx 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
