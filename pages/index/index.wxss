/**index.wxss**/

.card-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #111827;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
}

.sos-card .card-name {
  color: #e74c3c;
}

/* 浮动SOS按钮 */
.float-sos {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b81, #ff4757);
  box-shadow: 0 8rpx 24rpx rgba(255,71,87,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.3s ease;
}
.float-sos.show {
  opacity: 1;
  transform: scale(1);
}
.float-sos-icon {
  font-size: 50rpx;
}

/* 管理模式 - 快捷工作台 */
.admin-quick-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
}
.quick-item:active {
  background: #e9ecef;
}
.quick-icon {
  font-size: 40rpx;
}
.quick-label {
  font-size: 24rpx;
  color: #111827;
  font-weight: 500;
}

/* 管理模式 - 统计网格 */
.stats-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.stat-item {
  padding: 18rpx 12rpx;
  border-radius: 14rpx;
  background: #f8f9fa;
  text-align: center;
}
.stat-item.warn {
  background: #fff3cd;
}
.stat-item.danger {
  background: #ffe3e3;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}
.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
