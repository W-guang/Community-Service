/**app.wxss**/

/* ============================================================
   页面根节点
   ============================================================ */
page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  --brand: #1296db;
  --brand-dark: #0b7bc1;
  --brand-light: #e3f2fd;
  --accent-orange: #f59e0b;
  --accent-red: #ef4444;
  --accent-green: #10b981;
  --accent-purple: #8b5cf6;
  --bg-page: #f0f2f8;
  --bg-card: #ffffff;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --border-light: #f1f5f9;
  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0,0,0,0.06);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
}

/* ============================================================
   页面容器
   ============================================================ */
.page {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  background: linear-gradient(180deg, #eef1f9 0%, #f5f6fb 100%);
  overflow: hidden;
}

.page-container {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  background: linear-gradient(180deg, #eef1f9 0%, #f5f6fb 100%);
  overflow: hidden;
}

.scroll-content {
  flex: 1;
  min-height: 0;
}

/* ============================================================
   卡片
   ============================================================ */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.card-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

/* ============================================================
   文本
   ============================================================ */
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

.muted {
  color: #64748b;
  font-size: 26rpx;
}

.content {
  color: #1e293b;
  font-size: 28rpx;
  white-space: pre-wrap;
}

/* ============================================================
   按钮
   ============================================================ */
.btn-primary {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(59,130,246,0.25);
}

.btn-danger {
  background: linear-gradient(135deg, #f87171, #ef4444);
  color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(239,68,68,0.25);
}

.btn {
  border-radius: 24rpx;
  background: #ffffff;
  color: #1e293b;
  border: 1rpx solid #e2e8f0;
}

button.btn,
button.btn-primary,
button.btn-danger {
  border-radius: 24rpx;
  overflow: hidden;
  transition: all 0.2s;
}

button::after {
  border: none;
}

/* ============================================================
   布局工具
   ============================================================ */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.wrap {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.mt {
  margin-top: 12rpx;
}

/* ============================================================
   标签
   ============================================================ */
.tag {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef2ff;
  color: #3730a3;
}

.tag.status-open       { background: #d1fae5; color: #065f46; }
.tag.status-taken      { background: #dbeafe; color: #1e40af; }
.tag.status-waiting_confirm { background: #ede9fe; color: #5b21b6; }
.tag.status-done       { background: #d1fae5; color: #065f46; }
.tag.status-pending    { background: #fef3c7; color: #92400e; }
.tag.status-processing { background: #dbeafe; color: #1e40af; }

.tag-important { background: #fee2e2; color: #dc2626; }

/* ============================================================
   表单元素
   ============================================================ */
.field {
  margin-bottom: 30rpx;
}

.label {
  font-size: 30rpx;
  color: #1e293b;
  margin-bottom: 12rpx;
  font-weight: 500;
}

input {
  width: 100%;
  min-height: 80rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.4;
}

textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
}

.picker {
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #1e293b;
}

/* ============================================================
   头部
   ============================================================ */
.header-section {
  background: linear-gradient(135deg, #1e40af, #3b82f6, #60a5fa);
  padding: 100rpx 40rpx 60rpx 40rpx;
  color: white;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(59,130,246,0.2);
}

.greeting {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.date-tips {
  font-size: 28rpx;
  opacity: 0.8;
}

/* ============================================================
   公告栏
   ============================================================ */
.notice-bar {
  background-color: #fff;
  margin: -30rpx 30rpx 20rpx 30rpx;
  padding: 0 20rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  position: relative;
  z-index: 10;
}

.horn-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.notice-swiper {
  flex: 1;
  height: 100%;
}

.notice-text {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.urgent-tag {
  background-color: #fee2e2;
  color: #dc2626;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
  font-weight: bold;
}

/* ============================================================
   列表项
   ============================================================ */
.list-item {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.list-item + .list-item {
  margin-top: 16rpx;
}

/* ============================================================
   骨架屏
   ============================================================ */
.skeleton-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, #e5e7eb 25%, #f3f4f6 50%, #e5e7eb 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-line.short  { width: 40%; }
.skeleton-line.medium { width: 75%; }
.skeleton-line:last-child { margin-bottom: 0; }

@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============================================================
   空状态
   ============================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

/* ============================================================
   时间线
   ============================================================ */
.timeline { padding: 10rpx 0; }

.tl-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  position: relative;
}

.tl-item:not(:last-child) {
  padding-bottom: 20rpx;
}

.tl-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: #e5e7eb;
}

.tl-item.active:not(:last-child)::before {
  background: #3b82f6;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e5e7eb;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 4rpx;
  transition: all 0.3s;
}

.tl-item.active .tl-dot {
  background: #3b82f6;
  box-shadow: 0 0 0 6rpx rgba(59,130,246,0.15);
}

.tl-content { flex: 1; }

.tl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #9ca3af;
}

.tl-item.active .tl-title { color: #1e293b; }

.tl-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* ============================================================
   聊天气泡
   ============================================================ */
.comment-left  { display: flex; justify-content: flex-start; }
.comment-right { display: flex; justify-content: flex-end; }

.comment-bubble {
  max-width: 80%;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.bubble-resident {
  background: #dbeafe;
  border-bottom-left-radius: 4rpx;
}

.bubble-staff {
  background: #d1fae5;
  border-bottom-right-radius: 4rpx;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.5;
}

.comment-time {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  text-align: right;
}
